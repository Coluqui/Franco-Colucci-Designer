---
/**
 * /es/dev/motion — banco de pruebas del motion "Formato vivo" (docs/motion.md).
 * Arriba, las utilidades base (resortes con interrupción, FLIP, observer, movimiento reducido).
 * Abajo, un renglón por ID M01–M32: cada ID suma su botón de prueba cuando se implementa.
 * Página interna (solo `npm run dev`), en español.
 */
const ids: Array<[string, string, string]> = [
  ['M01', 'Glifo al cargar', 'Espera marca-formato.svg'],
  ['M02', 'Glifo: desencastre en hover', 'Espera marca-formato.svg'],
  ['M03', 'Glifo como confirmación', 'Espera marca-formato.svg · se conecta en Fase 7'],
  ['M04', 'Loop de formatos del hero', 'Listo · home, hero (tests/m04-loop.spec.ts)'],
  ['M05', 'Vista previa de servicios', 'Listo · home, servicios (tests/m05-servicios.spec.ts)'],
  ['M06', 'Fila de caso → caso', 'Listo · Trabajos y home → caso (tests/m06-m07-caso.spec.ts)'],
  ['M07', 'Caso → atrás / siguiente caso', 'Listo · caso (tests/m06-m07-caso.spec.ts)'],
  ['M08', 'Tile → visor', 'Listo · piezas del caso (tests/m08-m11-visor.spec.ts)'],
  ['M09', 'Cerrar el visor', 'Listo · ESC, × y arrastre vertical'],
  ['M10', 'Slides del carrusel', 'Listo · segmento scaleX'],
  ['M11', 'Pieza siguiente en el visor', 'Listo · Av Pág / Re Pág y botones'],
  ['M12', 'Filtros', 'Listo · Trabajos y caso (tests/m12-filtros.spec.ts)'],
  ['M13', 'Servicio activo (respiración)', 'Listo · home, servicios'],
  ['M14', 'Links del menú (respiración)', 'Listo · menú, al 60 % de M20'],
  ['M15', 'Frase-problema y cierre (lectura)', 'Listo · home, frase y cierre'],
  ['M16', 'Entrada de sección', 'Listo · home, secciones'],
  ['M17', 'Filas de caso', 'Listo · home y Trabajos'],
  ['M18', 'Métricas (sin animación)', '—'],
  ['M19', 'Header al scrollear', 'Listo · todas las páginas (tests/m19-m22-cromo.spec.ts)'],
  ['M20', 'Menú que crece desde el botón', 'Listo · header, "Menú"'],
  ['M21', 'Panel Hablemos', 'Listo · header, barra y cierre'],
  ['M22', 'Barra inferior mobile', 'Listo · angosto'],
  ['M23', 'Cambio de modo', 'Listo · menú y footer (tests/m23-m24-modo-idioma.spec.ts)'],
  ['M24', 'Cambio de idioma', 'Listo · menú y footer'],
  ['M25', 'Botón primario', 'Listo · sin el desencastre del glifo (falta el SVG)'],
  ['M26', 'Botón secundario y link', 'Listo'],
  ['M27', 'Fila de caso: hover', 'Listo · también con foco'],
  ['M28', 'Testimonios', 'Listo · solo en componentes (testimonios PENDIENTE)'],
  ['M29', 'FAQ', 'Listo'],
  ['M30', 'Copiar mail', 'Listo'],
  ['M31', 'Descargar CV', 'Listo · inactivo hasta tener CV'],
  ['M32', 'Formulario', 'Error y enviando · éxito y error de envío en Fase 7'],
];
const resortes = ['snap', 'soft', 'press'] as const;
---

<div class="container dev">
  <header class="dev-cabecera">
    <p class="t-label">Dev · motion v2.0 "Formato vivo"</p>
    <h1>Motion</h1>
    <p class="t-body nota">
      Movimiento reducido: <strong data-estado-reducido>—</strong>. Para probar la versión reducida, activala en el sistema
      o con Playwright (<code>page.emulateMedia(&#123; reducedMotion: 'reduce' &#125;)</code>).
    </p>
  </header>

  <section aria-labelledby="s-resortes">
    <h2 id="s-resortes">Resortes · animar()</h2>
    <p class="t-body nota">
      Cada botón lleva el marco al otro lado con el resorte del token. Hacé clic dos veces seguidas: la animación se
      interrumpe y vuelve desde donde estaba, sin saltos.
    </p>
    <ul class="pistas" role="list">
      {
        resortes.map((r) => (
          <li class="pista">
            <span class="marco" data-marco={r} />
            <button class="dev-boton" type="button" data-resorte={r}>
              --spring-{r}
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="s-flip">
    <h2 id="s-flip">FLIP · flip()</h2>
    <p class="t-body nota">Mezcla los marcos: viajan a su lugar nuevo con escala uniforme (nunca se deforman). Reducido: salto instantáneo.</p>
    <ul class="flip" role="list" data-flip>
      {['1:1', '4:5', '9:16', '3:1', '16:10'].map((r) => (
        <li class="flip__item t-label" style={`aspect-ratio: ${r.replace(':', ' / ')}`}>{r}</li>
      ))}
    </ul>
    <button class="dev-boton" type="button" data-mezclar>Mezclar</button>
  </section>

  <section aria-labelledby="s-observer">
    <h2 id="s-observer">Observer compartido · alEntrar()</h2>
    <p class="t-body nota">Scrolleá: cada bloque se marca una sola vez al entrar un 15 % (M16 y M17 usan esto).</p>
    <ol class="entradas" role="list">
      {[1, 2, 3, 4].map((n) => (
        <li class="entrada t-label" data-entrada>
          Bloque {n} · <span data-entrada-estado>esperando</span>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="s-ids">
    <h2 id="s-ids">Interacciones M01–M32</h2>
    <table class="ids">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Interacción</th>
          <th scope="col">Estado</th>
        </tr>
      </thead>
      <tbody>
        {
          ids.map(([id, nombre, estado]) => (
            <tr data-id={id}>
              <th scope="row" class="t-label">{id}</th>
              <td>{nombre}</td>
              <td class="t-label nota">{estado}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</div>

<script>
  import { animar, resorte, reducido, alCambiarReducido, type Resorte } from '../scripts/motion/base';
  import { flip, medir } from '../scripts/motion/flip';
  import { alEntrar } from '../scripts/motion/observer';
  import { enCadaPagina } from '../scripts/pagina';

  enCadaPagina(() => {
    const estado = document.querySelector('[data-estado-reducido]');
    const pintar = (r: boolean) => estado && (estado.textContent = r ? 'activo' : 'no');
    pintar(reducido());
    alCambiarReducido(pintar);

    // Resortes: ida y vuelta con interrupción.
    document.querySelectorAll<HTMLButtonElement>('[data-resorte]').forEach((b) => {
      let ida = true;
      b.addEventListener('click', () => {
        const r = b.dataset['resorte'] as Resorte;
        const marco = document.querySelector<HTMLElement>(`[data-marco="${r}"]`);
        const pista = marco?.parentElement;
        if (!marco || !pista) return;
        const x = ida ? pista.clientWidth - marco.offsetWidth : 0;
        animar(marco, { transform: `translateX(${x}px)` }, resorte(r));
        ida = !ida;
      });
    });

    // FLIP: medir, reordenar, invertir y soltar con el resorte de la grilla.
    const lista = document.querySelector<HTMLElement>('[data-flip]');
    document.querySelector('[data-mezclar]')?.addEventListener('click', () => {
      if (!lista) return;
      const items = [...lista.children] as HTMLElement[];
      const antes = new Map(items.map((el) => [el, medir(el)]));
      items
        .map((el) => ({ el, k: Math.random() }))
        .sort((a, b) => a.k - b.k)
        .forEach(({ el }) => lista.append(el));
      items.forEach((el) => flip(el, antes.get(el)!, resorte('soft')));
    });

    // Observer: una vez por bloque.
    document.querySelectorAll<HTMLElement>('[data-entrada]').forEach((el) =>
      alEntrar(el, () => {
        el.dataset['dentro'] = '';
        const s = el.querySelector('[data-entrada-estado]');
        if (s) s.textContent = 'entró (una vez)';
      }),
    );
  });
</script>

<style>
  .dev {
    display: grid;
    gap: var(--space-9);
    padding-block: var(--space-8) var(--space-section);
  }

  .dev-cabecera,
  section {
    display: grid;
    gap: var(--space-5);
  }

  .nota {
    color: var(--color-text-secondary);
  }

  .dev-boton {
    justify-self: start;
    min-block-size: var(--control-height);
    padding-inline: var(--control-pad-x);
    border: var(--border-control);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
    font-weight: var(--weight-ui);
    cursor: pointer;
  }

  .dev-boton:focus-visible {
    outline: var(--focus-ring);
  }

  .pistas,
  .flip,
  .entradas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pistas {
    display: grid;
    gap: var(--space-4);
  }

  .pista {
    display: grid;
    gap: var(--space-3);
  }

  .marco {
    display: block;
    inline-size: var(--space-8);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xs);
    background: var(--color-accent);
  }

  .flip {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4);
  }

  .flip__item {
    display: grid;
    place-items: center;
    inline-size: var(--space-10);
    border-radius: var(--radius-xs);
    background: var(--color-stage);
  }

  .entradas {
    display: grid;
    gap: var(--space-section);
  }

  .entrada {
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
  }

  .entrada[data-dentro] {
    border: var(--border-control);
  }

  .ids {
    border-collapse: collapse;
    inline-size: 100%;
  }

  .ids th,
  .ids td {
    padding: var(--space-2) var(--space-3);
    border-block-end: var(--border-hairline);
    text-align: start;
  }
</style>
