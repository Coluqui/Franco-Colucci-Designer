---
/**
 * /[lang]/dev/componentes — todos los componentes del design system §7 con sus estados.
 * Contenido de ejemplo marcado PENDIENTE (nunca contenido real inventado).
 * Modo: ?tema=light | ?tema=dark, o el toggle del menú/footer.
 */
import Boton from '../components/Boton.astro';
import Link from '../components/Link.astro';
import Toggle from '../components/Toggle.astro';
import Campo from '../components/Campo.astro';
import FilaCaso from '../components/FilaCaso.astro';
import ListaServicios from '../components/ListaServicios.astro';
import DevComponentesB from './DevComponentesB.astro';
import moondesk01 from './fixtures/moondesk-01.jpg';
import moondesk02 from './fixtures/moondesk-02.jpg';
import condimento01 from './fixtures/condimento-01.jpg';
import iscamen13 from './fixtures/iscamen-13.jpg';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = `/${lang}/dev/componentes`;
---

<div class="dev container">
  <header class="dev-cabecera">
    <p class="t-label">Dev · componentes · design system §7</p>
    <h1>Componentes</h1>
    <p class="t-body">
      Modo: <a class="link" href={`${base}?tema=light`}>claro</a> · <a class="link" href={`${base}?tema=dark`}>oscuro</a> ·
      <a class="link" href={base}>sistema</a>
    </p>
  </header>

  <section aria-labelledby="c-header">
    <h2 id="c-header">1 · Header</h2>
    <p class="t-body">
      Arriba de esta página. Transparente arriba; con scroll, fondo y filete; sobre la franja invertida de abajo se invierte. A
      menos de 768 px, "Hablemos" pasa a la barra inferior.
    </p>
    <div class="seccion-invertida caja-invertida franja-alta">
      <p class="t-body">Franja invertida: scrolleá hasta que pase debajo del header.</p>
    </div>
  </section>

  <section aria-labelledby="c-botones">
    <h2 id="c-botones">2 · Botones y links</h2>
    <div class="fila-demo">
      <Boton>Hablemos</Boton>
      <Boton size="sm">Hablemos (sm)</Boton>
      <Boton variante="secundario">Menú</Boton>
      <Boton variante="secundario" size="sm">Menú (sm)</Boton>
      <Boton variante="secundario" icono="flecha-abajo">CV</Boton>
    </div>
    <div class="fila-demo">
      <Boton disabled>Primario disabled</Boton>
      <Boton variante="secundario" disabled>Secundario disabled</Boton>
      <Boton loading textoCarga="Enviando">Enviar</Boton>
      <Boton href={null}>Link pendiente</Boton>
    </div>
    <p class="t-body">
      Texto con <Link href="#c-botones" lang={lang}>un link interno</Link>, <Link href="https://example.com" lang={lang} externo
        >un link externo</Link
      > y <Link href={null} lang={lang}>un dato pendiente</Link>.
    </p>
    <div class="seccion-invertida caja-invertida fila-demo">
      <p class="t-body">Sobre sección invertida: <Link href="#c-botones" lang={lang}>link</Link></p>
      <Boton>Hablemos</Boton>
      <Boton variante="secundario">Secundario</Boton>
    </div>
  </section>

  <section aria-labelledby="c-toggles">
    <h2 id="c-toggles">3 · Toggles</h2>
    <div class="fila-demo">
      <Toggle lang={lang} tipo="idioma" />
      <Toggle lang={lang} tipo="modo" />
    </div>
    <div class="seccion-invertida caja-invertida fila-demo">
      <Toggle lang={lang} tipo="idioma" />
      <Toggle lang={lang} tipo="modo" />
    </div>
  </section>

  <section aria-labelledby="c-panel">
    <h2 id="c-panel">4 · Menú y panel Hablemos</h2>
    <p class="t-body">
      El menú se abre con "Menú" del header. El panel, con "Hablemos" (header en desktop) o con este botón. Sin JS, el link lleva a
      la página Hablemos.
    </p>
    <div class="fila-demo">
      <Boton href={`/${lang}/hablemos/`} data-abre-panel aria-haspopup="dialog">Abrir panel Hablemos</Boton>
    </div>
  </section>

  <section aria-labelledby="c-fila">
    <h2 id="c-fila">6 · Fila de caso</h2>
    <p class="t-body">Hover: la media escala y aparece "Ver caso →". Tab: anillo en todo el panel. Angosta: media arriba.</p>
    <FilaCaso
      lang={lang}
      href="#c-fila"
      titulo="PENDIENTE: caso uno"
      tipo="PENDIENTE · tipo de trabajo"
      descripcion="PENDIENTE: descripción corta del caso, una o dos líneas con el problema y lo que se hizo."
      servicios={['Redes', 'Ads', 'Branding']}
      imagen={moondesk02}
      alt="PENDIENTE: alt de la pieza"
    />
    <FilaCaso
      lang={lang}
      href="#c-fila"
      titulo="PENDIENTE: caso dos, título más largo"
      tipo="PENDIENTE"
      descripcion="PENDIENTE: descripción corta del caso."
      servicios={['Redes']}
      imagen={iscamen13}
      alt="PENDIENTE: alt de la pieza"
    />
  </section>

  <section aria-labelledby="c-servicios">
    <h2 id="c-servicios">7 · Lista de servicios</h2>
    <p class="t-body">
      Ancho: hover (80 ms) o foco abren el servicio y el marco toma su formato. Angosto: acordeón. Mail, Web y Branding sin pieza
      (PENDIENTE).
    </p>
    <ListaServicios
      lang={lang}
      servicios={[
        { slug: 'ads', nombre: 'Ads', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'square', imagen: condimento01, alt: 'PENDIENTE: alt' },
        { slug: 'redes', nombre: 'Redes', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'carousel', imagen: moondesk01, alt: 'PENDIENTE: alt' },
        { slug: 'reels', nombre: 'Reels', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'reel', imagen: iscamen13, alt: 'PENDIENTE: alt' },
        { slug: 'mail', nombre: 'Mail', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'mail-header' },
        { slug: 'web', nombre: 'Web', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'web' },
        { slug: 'branding', nombre: 'Branding', descripcion: 'PENDIENTE: descripción del servicio.', ratio: 'carousel' },
      ]}
    />
  </section>

  <DevComponentesB lang={lang} />

  <section aria-labelledby="c-campos">
    <h2 id="c-campos">15 · Campos</h2>
    <form class="grilla-campos" onsubmit="return false" novalidate>
      <Campo id="demo-nombre" name="demo-nombre" label="Nombre" autocomplete="off" required textoObligatorio="(obligatorio)" />
      <Campo id="demo-email" name="demo-email" tipo="email" label="Email" value="franco@" error="Revisá el formato del email." />
      <Campo id="demo-ok" name="demo-ok" label="Nombre (válido)" value="PENDIENTE" exito />
      <Campo id="demo-off" name="demo-off" label="Deshabilitado" value="PENDIENTE" disabled />
      <Campo id="demo-mensaje" name="demo-mensaje" tipo="textarea" label="Mensaje" />
    </form>
  </section>
</div>

<style>
  .dev {
    display: grid;
    gap: var(--space-9);
    padding-block: var(--space-8) var(--space-section);
  }

  .dev-cabecera,
  section {
    display: grid;
    gap: var(--space-5);
  }

  .fila-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .caja-invertida {
    padding: var(--space-5);
    border-radius: var(--radius-sm);
  }

  .grilla-campos {
    display: grid;
    gap: var(--space-5);
    max-inline-size: 32rem;
  }

  .franja-alta {
    min-block-size: 60vh;
  }
</style>
