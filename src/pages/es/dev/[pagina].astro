---
/**
 * Páginas internas de desarrollo (/es/dev/*). Solo existen con `npm run dev`:
 * en el build de producción getStaticPaths no devuelve rutas.
 * Son herramientas internas: textos en español, sin i18n y con noindex.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import DevTokens from '../../../dev/DevTokens.astro';
import DevColores from '../../../dev/DevColores.astro';

const paginas = {
  tokens: { titulo: 'Dev · Tokens', componente: DevTokens },
  colores: { titulo: 'Dev · Colores', componente: DevColores },
} as const;

type Pagina = keyof typeof paginas;

// getStaticPaths corre aislado del resto del frontmatter: la lista va acá adentro.
export const getStaticPaths = (() =>
  import.meta.env.PROD ? [] : ['tokens', 'colores'].map((pagina) => ({ params: { pagina } }))) satisfies GetStaticPaths;

const pagina = Astro.params.pagina as Pagina;
const { titulo, componente: Componente } = paginas[pagina];
---

<Base lang="es" title={titulo} description={titulo} noindex alternates={false}>
  {
    pagina === 'colores' && (
      <script
        slot="head"
        is:inline
        set:html="try { var t = new URLSearchParams(location.search).get('tema'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}"
      />
    )
  }
  <Componente />
</Base>
