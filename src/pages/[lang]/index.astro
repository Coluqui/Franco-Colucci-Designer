---
/**
 * Home provisoria (Fase 1): solo verifica rutas /es/ y /en/ y el diccionario.
 * La home real (PRD §5) se construye en la Fase 4.
 */
import type { GetStaticPaths } from 'astro';
import { locales, t, switchLangPath, type Lang } from '../../i18n';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t(lang, 'meta.siteTitle')}</title>
    <meta name="description" content={t(lang, 'meta.siteDescription')} />
  </head>
  <body>
    <main>
      <h1>{t(lang, 'meta.siteTitle')}</h1>
      <p>{t(lang, 'placeholder.underConstruction')}</p>
      <p><a href={switchLangPath(Astro.url, other)} hreflang={other} lang={other}>{t(lang, 'lang.switchTo')}</a></p>
    </main>
  </body>
</html>
