---
/**
 * /[lang]/hablemos/ · PRD §5: la versión sin JS del panel Hablemos (los [data-abre-panel] apuntan acá).
 * On-demand: el formulario postea a la acción `contacto` y esta página se vuelve a dibujar con el
 * resultado (error por campo, error de envío o éxito), sin perder lo escrito. Con JS, el mismo
 * formulario envía sin recargar (FormHablemos).
 */
import { actions, isInputError } from 'astro:actions';
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import FormHablemos from '../../components/FormHablemos.astro';
import { isLang, t } from '../../i18n';
import { mailHref, linkedinHref, whatsappHref, cvHref } from '../../config/site';

export const prerender = false;

const lang = Astro.params.lang;
// Idioma inválido: un 404 vacío (Astro sirve la página 404, que es estática).
if (!isLang(lang)) return new Response(null, { status: 404 });
const cv = cvHref(lang);

const resultado = Astro.getActionResult(actions.contacto);
let estado: 'exito' | 'error' | undefined;
let errores: Record<string, string> = {};
let valores: Record<string, string> = {};
if (resultado?.error) {
  // Lo escrito vuelve a los campos (PRD §11: error sin perder lo escrito).
  const datos = await Astro.request.formData().catch(() => null);
  valores = Object.fromEntries(['nombre', 'email', 'mensaje'].map((c) => [c, String(datos?.get(c) ?? '')]));
  if (isInputError(resultado.error)) errores = Object.fromEntries(Object.entries(resultado.error.fields).map(([c, m]) => [c, String(m?.[0] ?? '')]));
  else estado = 'error';
} else if (resultado) {
  estado = 'exito';
}
---

<Base lang={lang} title={`${t(lang, 'pages.talk.title')} · Franco Colucci`} description={t(lang, 'pages.talk.description')} chrome>
  <div class="container hablemos">
    <h1>{t(lang, 'talk.title')}</h1>
    <p class="t-lead">{t(lang, 'form.intro')}</p>
    <FormHablemos lang={lang} id="pagina" {valores} {errores} {estado} momento={Date.now()} />
    <section class="hablemos__directo" aria-labelledby="hablemos-directo">
      <h2 id="hablemos-directo" class="t-h3">{t(lang, 'contact.direct')}</h2>
      <ul role="list">
        <li><Link href={mailHref()} lang={lang}>{t(lang, 'contact.email')}</Link></li>
        <li><Link href={linkedinHref()} lang={lang} externo>{t(lang, 'contact.linkedin')}</Link></li>
        <li><Link href={whatsappHref()} lang={lang} externo>{t(lang, 'contact.whatsapp')}</Link></li>
        <li><Link href={cv} lang={lang} download={cv ? '' : undefined}>{t(lang, 'contact.downloadCv')}</Link></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .hablemos {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-section);
  }

  .hablemos > * {
    margin: 0;
    max-inline-size: var(--measure);
  }

  .hablemos__directo {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline);
  }

  .hablemos__directo h2 {
    margin: 0;
  }

  .hablemos__directo ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hablemos__directo li {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
  }
</style>
