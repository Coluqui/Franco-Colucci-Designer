---
/**
 * Caso · PRD §5: título + frase + datos (cliente, rol, año, servicios, herramientas) · hero 16:8
 * · métricas grandes · El problema · Lo que hice · Piezas filtrables por formato + visor · Resultado
 * · Testimonio · Siguiente caso (invertido).
 * Bloques sin datos reales: métricas y testimonio no se muestran; piezas muestran un estado vacío.
 * Fase 6: transition:name en la media y el título (M06–M07).
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import MetricasGrandes from '../../../components/MetricasGrandes.astro';
import Pasos from '../../../components/Pasos.astro';
import Filtros from '../../../components/Filtros.astro';
import TilePieza from '../../../components/TilePieza.astro';
import Visor from '../../../components/Visor.astro';
import SiguienteCaso from '../../../components/SiguienteCaso.astro';
import Link from '../../../components/Link.astro';
import type { PiezaVista } from '../../../components/tipos';
import { locales, t, localizePath, type Lang } from '../../../i18n';
import { getCasos, getPiezasDeCaso, siguienteCaso, nombreServicio, hrefCaso, type Caso } from '../../../lib/casos';
import { formatos } from '../../../content.config';

export const getStaticPaths = (async () => {
  const casos = await getCasos();
  return locales.flatMap((lang) => casos.map((caso) => ({ params: { lang, slug: caso.slug }, props: { caso } })));
}) satisfies GetStaticPaths;

interface Props {
  caso: Caso;
}

const lang = Astro.params.lang as Lang;
const { caso } = Astro.props;
const casos = await getCasos();
const siguiente = siguienteCaso(casos, caso.slug);
const piezasData = await getPiezasDeCaso(caso.slug);

const piezas: Array<PiezaVista & { filtro: string }> = piezasData.map((p) => ({
  slug: p.slug,
  cliente: caso.cliente,
  formato: t(lang, `formats.${p.formato}`),
  ratio: p.ratio,
  slides: p.slides.map((s) => ({ src: s.src, alt: s.alt[lang] })),
  filtro: p.formato,
}));

const opcionesFormato = formatos
  .map((f) => ({ valor: f, nombre: t(lang, `formats.${f}`), cantidad: piezasData.filter((p) => p.formato === f).length }))
  .filter((o) => o.cantidad > 0);

const datos = [
  { etiqueta: t(lang, 'caseDetail.client'), valor: caso.cliente },
  { etiqueta: t(lang, 'caseDetail.role'), valor: caso.rol[lang] },
  ...(caso.anio ? [{ etiqueta: t(lang, 'caseDetail.year'), valor: String(caso.anio) }] : []),
  { etiqueta: t(lang, 'caseDetail.services'), valor: caso.servicios.map((s) => nombreServicio(lang, s)).join(' · ') },
  ...(caso.herramientas.length ? [{ etiqueta: t(lang, 'caseDetail.tools'), valor: caso.herramientas.join(' · ') }] : []),
];
---

<Base lang={lang} title={`${caso.titulo[lang]} · Franco Colucci`} description={caso.frase[lang]} chrome>
  <article class="caso">
    <header class="container caso__cabecera">
      <p class="t-ui caso__volver">
        <Link href={localizePath(lang, 'trabajos/')} lang={lang}>{t(lang, 'caseDetail.back')}</Link>
      </p>
      <div class="caso__intro">
        <h1>{caso.titulo[lang]}</h1>
        <p class="t-lead caso__frase">{caso.frase[lang]}</p>
      </div>
      <dl class="caso__datos">
        {
          datos.map((d) => (
            <div>
              <dt class="t-dato">{d.etiqueta}</dt>
              <dd class="t-body">{d.valor}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="container">
      <div class="caso__hero">
        {
          caso.hero ? (
            <Image
              src={caso.hero}
              alt={caso.heroAlt?.[lang] ?? ''}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 82rem) 82rem, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="t-label">{t(lang, 'caseDetail.heroPending')}</span>
          )
        }
      </div>
    </div>

    {
      caso.metricas.length > 0 && (
        <div class="container caso__bloque">
          <MetricasGrandes
            etiqueta={t(lang, 'caseDetail.metrics')}
            metricas={caso.metricas.map((m) => ({ valor: m.valor, etiqueta: m.etiqueta[lang] }))}
          />
        </div>
      )
    }

    <section class="container caso__bloque caso__texto" aria-labelledby="problema">
      <h2 id="problema">{t(lang, 'caseDetail.problem')}</h2>
      <p class="t-body">{caso.problema[lang]}</p>
    </section>

    <section class="container caso__bloque caso__texto" aria-labelledby="lo-que-hice">
      <h2 id="lo-que-hice">{t(lang, 'caseDetail.whatIDid')}</h2>
      <Pasos pasos={caso.pasos.map((p) => p[lang])} />
    </section>

    <section class="container caso__bloque" aria-labelledby="piezas">
      <h2 id="piezas">{t(lang, 'caseDetail.pieces')}</h2>
      {
        piezas.length > 0 ? (
          <>
            {opcionesFormato.length > 1 && (
              <Filtros
                lang={lang}
                etiqueta={t(lang, 'filters.byFormat')}
                opciones={opcionesFormato}
                objetivo="piezas-caso"
                param="formato"
                total={piezas.length}
              />
            )}
            <div class="caso__piezas" id="piezas-caso">
              {piezas.map((p) => (
                <TilePieza lang={lang} pieza={p} filtro={p.filtro} />
              ))}
            </div>
            <Visor lang={lang} piezas={piezas} />
          </>
        ) : (
          <p class="t-body caso__vacio">{t(lang, 'caseDetail.piecesEmpty')}</p>
        )
      }
    </section>

    <section class="container caso__bloque caso__texto" aria-labelledby="resultado">
      <h2 id="resultado">{t(lang, 'caseDetail.result')}</h2>
      <p class="t-body">{caso.resultado[lang]}</p>
    </section>

    {
      caso.testimonio && (
        <section class="container caso__bloque" aria-labelledby="testimonio">
          <h2 id="testimonio" class="visually-hidden">
            {t(lang, 'caseDetail.testimonial')}
          </h2>
          <figure class="caso__testimonio">
            <blockquote class="t-h2">{caso.testimonio.cita[lang]}</blockquote>
            <figcaption>
              {caso.testimonio.autor} · {caso.testimonio.rol[lang]}
            </figcaption>
          </figure>
        </section>
      )
    }
  </article>

  {
    siguiente && (
      <SiguienteCaso lang={lang} href={hrefCaso(lang, siguiente.slug)} titulo={siguiente.titulo[lang]} frase={siguiente.frase[lang]} />
    )
  }
</Base>

<style>
  .caso {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-section);
  }

  .caso__cabecera {
    display: grid;
    gap: var(--space-6);
  }

  .caso__volver {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .caso__volver,
  .caso__intro h1,
  .caso__frase {
    margin: 0;
  }

  .caso__intro {
    display: grid;
    gap: var(--space-5);
  }

  .caso__intro h1 {
    text-wrap: balance;
  }

  .caso__frase {
    max-inline-size: var(--measure);
    color: var(--color-text-secondary);
  }

  .caso__datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--grid-gutter);
    margin: 0;
  }

  .caso__datos div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .caso__datos dd {
    margin: 0;
  }

  /* ≥ 1280: datos del caso a la derecha (design system §8). */
  @media (min-width: 80rem) {
    .caso__cabecera {
      grid-template-columns: 7fr 5fr;
      column-gap: calc(var(--grid-gutter) * 2 + (100% - 11 * var(--grid-gutter)) / 12);
      align-items: end;
    }

    .caso__volver {
      grid-column: 1 / -1;
    }
  }

  .caso__hero {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio-case-hero);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-stage);
    color: var(--color-text-secondary);
  }

  .caso__hero :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .caso__bloque {
    display: grid;
    gap: var(--space-6);
  }

  .caso__bloque h2,
  .caso__bloque p {
    margin: 0;
  }

  .caso__texto > p {
    max-inline-size: var(--measure);
  }

  .caso__vacio {
    color: var(--color-text-secondary);
  }

  .caso__piezas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .caso__piezas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .caso__piezas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .caso__testimonio {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .caso__testimonio blockquote {
    margin: 0;
    font-stretch: calc(var(--wdth-normal) * 1%);
    font-weight: var(--weight-ui);
  }

  .caso__testimonio figcaption {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
</style>
