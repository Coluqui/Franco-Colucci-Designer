---
/**
 * Proyecto · PRD v4.0 §5: empresa (H1) + rol · qué es la empresa y cómo fue el proyecto · hero
 * · piezas agrupadas por tipo (Redes, Ads, Documentos…) + visor · Siguiente proyecto (invertido).
 * Sin hero propio, el hero es la portada de la primera pieza: entera sobre su escenario, a lo sumo
 * 80 % del alto de pantalla (auditoría 25 nov: recortada a 1300 px no se leía).
 * transition:name en la media y el título: la card de la home se convierte en este hero.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import TilePieza from '../../../components/TilePieza.astro';
import Visor from '../../../components/Visor.astro';
import SiguienteCaso from '../../../components/SiguienteCaso.astro';
import Link from '../../../components/Link.astro';
import Icono from '../../../components/Icono.astro';
import { locales, t, localizePath, type Lang } from '../../../i18n';
import { getCasos, getPiezasDeCaso, siguienteCaso, nombreTipo, hrefCaso, piezaVista, type Caso } from '../../../lib/casos';

export const getStaticPaths = (async () => {
  const casos = await getCasos();
  return locales.flatMap((lang) => casos.map((caso) => ({ params: { lang, slug: caso.slug }, props: { caso } })));
}) satisfies GetStaticPaths;

interface Props {
  caso: Caso;
}

const lang = Astro.params.lang as Lang;
const { caso } = Astro.props;
const siguiente = siguienteCaso(await getCasos(), caso.slug);
const piezasData = await getPiezasDeCaso(caso.slug);

const vista = (p: (typeof piezasData)[number]) => piezaVista(lang, caso.cliente, p);

/** Grupos en el orden de `tiposPieza`; el visor recorre las piezas en ese mismo orden. */
const grupos = caso.tipos.map(({ tipo, cantidad }) => ({
  tipo,
  nombre: nombreTipo(lang, tipo),
  cantidad,
  piezas: piezasData.filter((p) => p.tipo === tipo).map(vista),
}));
const piezas = grupos.flatMap((g) => g.piezas);
---

<Base lang={lang} title={`${caso.cliente} · Franco Colucci`} description={caso.descripcion[lang]} chrome>
  <article class="caso">
    <header class="container caso__cabecera">
      <p class="t-ui caso__volver" data-entra>
        <Link href={localizePath(lang, 'trabajos/')} lang={lang} class="link--suelto"><Icono nombre="flecha-izq" class="icono--atras" />{t(lang, 'caseDetail.back')}</Link>
      </p>
      <div class="caso__intro">
        <h1><span class="caso__nombre" transition:name={`caso-${caso.slug}-titulo`} transition:animate="initial">{caso.cliente}</span></h1>
        <p class="t-lead caso__frase" data-entra>{caso.descripcion[lang]}</p>
      </div>
      <dl class="caso__datos" data-entra>
        <div>
          <dt class="t-dato">{t(lang, 'caseDetail.role')}</dt>
          <dd class="t-body">{caso.rol[lang]}</dd>
        </div>
        <div>
          <dt class="t-dato">{t(lang, 'caseDetail.pieces')}</dt>
          <dd class="t-body">{grupos.map((g) => <span class="caso__tipo">{g.nombre}: {g.cantidad}</span>)}</dd>
        </div>
      </dl>
    </header>

    <div class="container">
      <div class="caso__hero" data-reveal="clip" transition:name={`caso-${caso.slug}-media`} transition:animate="initial">
        {
          caso.portada ? (
            <Image
              src={caso.portada.src}
              alt={caso.portada.alt[lang]}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 82rem) 82rem, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="t-label">{t(lang, 'caseDetail.heroPending')}</span>
          )
        }
      </div>
    </div>

    {
      caso.reel && (
        <section class="container caso__bloque" aria-labelledby="reel">
          <h2 id="reel" class="caso__grupo" data-reveal>{t(lang, 'caseDetail.reel')}</h2>
          <video class="caso__reel" data-reveal="clip" src={caso.reel.src} poster={caso.reel.poster} aria-label={caso.reel.titulo[lang]} controls playsinline preload="none" />
        </section>
      )
    }
    {
      grupos.map((g) => (
        <section class="container caso__bloque" aria-labelledby={`tipo-${g.tipo}`}>
          <h2 id={`tipo-${g.tipo}`} class="caso__grupo" data-reveal>
            {g.nombre} <span class="t-label caso__cantidad">{g.cantidad}</span>
          </h2>
          <div class="caso__piezas">
            {g.piezas.map((p) => (
              <TilePieza lang={lang} pieza={p} />
            ))}
          </div>
        </section>
      ))
    }
    {piezas.length > 0 ? <Visor lang={lang} piezas={piezas} /> : <p class="container t-body caso__vacio">{t(lang, 'caseDetail.piecesEmpty')}</p>}
  </article>

  {
    siguiente && (
      <SiguienteCaso lang={lang} slug={siguiente.slug} href={hrefCaso(lang, siguiente.slug)} titulo={siguiente.cliente} frase={siguiente.rol[lang]} />
    )
  }
</Base>

<style>
  .caso {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-section);
  }

  .caso__cabecera {
    display: grid;
    gap: var(--space-6);
  }

  .caso__volver,
  .caso__intro h1,
  .caso__frase {
    margin: 0;
  }

  .caso__intro {
    display: grid;
    gap: var(--space-5);
  }

  .caso__intro h1 {
    text-wrap: balance;
  }

  .caso__frase {
    max-inline-size: var(--measure);
    color: var(--color-text-secondary);
  }

  .caso__datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--grid-gutter);
    margin: 0;
  }

  .caso__datos div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .caso__datos dd {
    display: grid;
    margin: 0;
  }

  /* ≥ 1280: datos del caso a la derecha (design system §8). */
  @media (min-width: 80rem) {
    .caso__cabecera {
      grid-template-columns: 7fr 5fr;
      column-gap: calc(var(--grid-gutter) * 2 + (100% - 11 * var(--grid-gutter)) / 12);
      align-items: end;
    }

    .caso__volver {
      grid-column: 1 / -1;
    }
  }

  .caso__hero {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio-case-hero);
    position: relative;
    max-block-size: 80dvh;
    inline-size: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-stage);
    color: var(--color-text-secondary);
  }

  /* Absoluta: el alto de la imagen sigue al de la caja (con max-block-size un 100 % no resuelve). */
  .caso__hero :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .caso__bloque {
    display: grid;
    gap: var(--space-6);
  }

  /* Reel vertical: entero, sin recortar; los controles nativos permiten pausar. */
  .caso__reel {
    inline-size: min(100%, 22rem);
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-sm);
    background: var(--color-stage);
  }

  .caso__bloque h2,
  .caso__bloque p {
    margin: 0;
  }

  .caso__texto > p {
    max-inline-size: var(--measure);
  }

  .caso__vacio {
    color: var(--color-text-secondary);
  }

  .caso__piezas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
    /* Proporciones mezcladas: las etiquetas comparten línea y el hueco queda arriba. */
    align-items: end;
  }

  @media (min-width: 48rem) {
    .caso__piezas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .caso__piezas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .caso__grupo {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .caso__cantidad {
    color: var(--color-text-secondary);
  }
</style>
