---
/**
 * Trabajos · PRD v4.0 §5: "Filtrar por tipo" + una card por proyecto (empresa, rol, descripción, piezas por tipo).
 * Sin JS se ven todos; con JS el filtro oculta los proyectos sin piezas de ese tipo y escribe ?tipo=.
 * Solo se ofrecen los tipos que tienen al menos un proyecto.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Filtros from '../../../components/Filtros.astro';
import FilaCaso from '../../../components/FilaCaso.astro';
import { locales, t, type Lang } from '../../../i18n';
import { getCasos, filaDeCaso, nombreTipo } from '../../../lib/casos';
import { tiposPieza } from '../../../content.config';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const casos = await getCasos();

const opciones = tiposPieza
  .map((tipo) => ({ valor: tipo, nombre: nombreTipo(lang, tipo), cantidad: casos.filter((c) => c.tipos.some((x) => x.tipo === tipo)).length }))
  .filter((o) => o.cantidad > 0);
---

<Base lang={lang} title={`${t(lang, 'pages.work.title')} · Franco Colucci`} description={t(lang, 'pages.work.description')} chrome>
  <div class="container trabajos">
    <header class="trabajos__cabecera">
      <h1>{t(lang, 'work.title')}</h1>
      <p class="t-lead trabajos__intro">{t(lang, 'work.intro')}</p>
    </header>

    <Filtros
      lang={lang}
      etiqueta={t(lang, 'filters.byType')}
      opciones={opciones}
      objetivo="lista-casos"
      param="tipo"
      total={casos.length}
      unidad="casos"
    />

    <ul class="trabajos__lista" id="lista-casos" role="list">
      {
        casos.map((c, i) => (
          <li data-filtro={c.tipos.map((x) => x.tipo).join(' ')}>
            <FilaCaso lang={lang} {...filaDeCaso(lang, c)} nivel="h2" prioridad={i === 0} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .trabajos {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-6) var(--space-section);
  }

  .trabajos__cabecera {
    display: grid;
    gap: var(--space-5);
  }

  .trabajos__cabecera h1,
  .trabajos__intro {
    margin: 0;
  }

  .trabajos__intro {
    max-inline-size: var(--measure);
    color: var(--color-text-secondary);
  }

  .trabajos__lista {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trabajos__lista > [hidden] {
    display: none;
  }
</style>
