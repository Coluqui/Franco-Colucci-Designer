---
/**
 * Trabajos · PRD §5 y §7: "Filtrar por servicio" + filas de caso (métrica destacada, descripción y servicios).
 * Sin JS se ven todos los casos; con JS el filtro oculta los que no tienen el servicio y escribe ?servicio=.
 * Solo se ofrecen los servicios que tienen al menos un caso.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Filtros from '../../../components/Filtros.astro';
import FilaCaso from '../../../components/FilaCaso.astro';
import { locales, t, type Lang } from '../../../i18n';
import { getCasos, filaDeCaso } from '../../../lib/casos';
import { ordenServicios } from '../../../config/servicios';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const casos = await getCasos();

const opciones = ordenServicios
  .map((s) => ({ valor: s, nombre: t(lang, `serviceItems.${s}.short`), cantidad: casos.filter((c) => c.servicios.includes(s)).length }))
  .filter((o) => o.cantidad > 0);
---

<Base lang={lang} title={`${t(lang, 'pages.work.title')} · Franco Colucci`} description={t(lang, 'pages.work.description')} chrome>
  <div class="container trabajos">
    <header class="trabajos__cabecera">
      <h1>{t(lang, 'work.title')}</h1>
      <p class="t-lead trabajos__intro">{t(lang, 'work.intro')}</p>
    </header>

    <Filtros
      lang={lang}
      etiqueta={t(lang, 'filters.byService')}
      opciones={opciones}
      objetivo="lista-casos"
      param="servicio"
      total={casos.length}
      unidad="casos"
    />

    <ul class="trabajos__lista" id="lista-casos" role="list">
      {
        casos.map((c, i) => (
          <li data-filtro={c.servicios.join(' ')}>
            <FilaCaso lang={lang} {...filaDeCaso(lang, c)} nivel="h2" prioridad={i === 0} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .trabajos {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-6) var(--space-section);
  }

  .trabajos__cabecera {
    display: grid;
    gap: var(--space-5);
  }

  .trabajos__cabecera h1,
  .trabajos__intro {
    margin: 0;
  }

  .trabajos__intro {
    max-inline-size: var(--measure);
    color: var(--color-text-secondary);
  }

  .trabajos__lista {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trabajos__lista > [hidden] {
    display: none;
  }
</style>
