---
/**
 * Panel Hablemos · design system §7 y §8 · PRD §5. Fase 3: solo la estructura.
 * <dialog> modal: desde la derecha en desktop (--drawer-width), pantalla completa en mobile.
 * Velo --color-scrim; cierra con ESC, × o clic en el velo; el foco vuelve a quien lo abrió.
 * Se abre desde cualquier [data-abre-panel] (header, barra mobile, cierre). Esos son links a
 * /[lang]/hablemos/: sin JS llevan a la página, con JS abren el panel.
 * El formulario (envío, anti-spam y estados M32) es FormHablemos, compartido con /[lang]/hablemos/.
 */
import FormHablemos from './FormHablemos.astro';
import Link from './Link.astro';
import Icono from './Icono.astro';
import { t, type Lang } from '../i18n';
import { site, mailHref, linkedinHref, whatsappHref, cvHref } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog id="panel-hablemos" class="panel" aria-labelledby="panel-hablemos-titulo" data-panel>
  <div class="panel__interior">
    <div class="panel__cabecera">
      <h2 id="panel-hablemos-titulo" class="t-h2">{t(lang, 'form.title')}</h2>
      <button class="panel__cerrar" type="button" data-cierra-panel autofocus aria-label={t(lang, 'form.closePanel')}>
        <Icono nombre="cerrar" size="1.25rem" />
      </button>
    </div>

    <p class="t-body panel__intro">{t(lang, 'form.intro')}</p>

    <FormHablemos lang={lang} id="panel" />

    <section class="panel__directo" aria-labelledby="panel-hablemos-directo">
      <h3 id="panel-hablemos-directo" class="panel__subtitulo">{t(lang, 'contact.direct')}</h3>
      <ul role="list">
        <!-- M30 · el mail se lee y se selecciona fuera del botón; el botón solo copia. -->
        <li class="panel__mail">
          <Link href={mailHref()} lang={lang}>{site.mail ?? t(lang, 'contact.email')}</Link>
          <button
            class="panel__copiar link"
            type="button"
            data-copiar={site.mail ?? undefined}
            disabled={!site.mail}
            data-texto={t(lang, 'contact.copyEmail')}
            data-texto-ok={t(lang, 'contact.copied')}
            data-texto-error={t(lang, 'contact.copyFailed')}
          >
            <span data-copiar-texto>{t(lang, 'contact.copyEmail')}</span>
            {!site.mail && <span class="visually-hidden">{t(lang, 'a11y.pending')}</span>}
          </button>
          <span class="visually-hidden" aria-live="polite" data-copiar-estado></span>
        </li>
        <li><Link href={linkedinHref()} lang={lang} externo>{t(lang, 'contact.linkedin')}</Link></li>
        <li><Link href={whatsappHref()} lang={lang} externo>{t(lang, 'contact.whatsapp')}</Link></li>
        <li><Link href={cvHref(lang)} lang={lang} download>{t(lang, 'contact.downloadCv')}</Link></li>
      </ul>
    </section>
  </div>
</dialog>

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { animar, curva, detener, ms, numero, resorte, rodarTexto } from '../scripts/motion/base';

  /** Campos que entran escalonados al abrir (M21: máx. 4). */
  const MAX_CAMPOS = 4;

  /**
   * M21 · desktop: el panel entra desde la derecha; mobile: sube desde abajo, a pantalla completa
   * (--spring-soft). El velo aparece en 300 ms. Los campos entran con --stagger-fast (máx. 4).
   * Cierre con ESC, × o el velo: sale en 300 · in y el foco vuelve a quien lo abrió (nativo).
   */
  enCadaPagina(() => {
    const panel = document.querySelector<HTMLDialogElement>('[data-panel]');
    if (!panel) return;
    // El header persiste entre páginas: sus escuchas se sueltan al salir (si no, se acumulan).
    const ac = new AbortController();
    const signal = ac.signal;
    const interior = panel.querySelector<HTMLElement>('.panel__interior')!;
    const campos = [...panel.querySelectorAll<HTMLElement>('[data-form-hablemos] form > :is(.campo, .boton)')].slice(0, MAX_CAMPOS);
    let velo: Animation | null = null;
    let cerrando = false;

    /** Afuera: a la derecha en desktop, abajo en mobile (el panel ocupa la pantalla). */
    const afuera = () => (matchMedia('(min-width: 48rem)').matches ? 'translateX(100%)' : 'translateY(100%)');

    const fundirVelo = (hasta: number, opciones: { easing: string; duration: number }) => {
      const desde = velo ? Number(getComputedStyle(panel, '::backdrop').opacity) : 1 - hasta;
      velo?.cancel();
      velo = panel.animate({ opacity: [desde, hasta] }, { ...opciones, pseudoElement: '::backdrop', fill: 'forwards' });
    };

    const abrir = () => {
      cerrando = false;
      if (!panel.open) panel.showModal();
      fundirVelo(1, curva('out', 'base'));
      animar(interior, { transform: 'none' }, { ...resorte('soft'), desde: { transform: afuera() }, soltar: true });
      const paso = ms('--stagger-fast');
      const bajar = `translateY(${numero('--shift-md')}px)`;
      campos.forEach((c, k) =>
        animar(c, { opacity: '1', transform: 'none' }, {
          ...resorte('soft'),
          delay: (k + 1) * paso,
          desde: { opacity: '0', transform: bajar },
          soltar: true,
        }),
      );
    };

    const cerrarPanel = async () => {
      if (!panel.open || cerrando) return;
      cerrando = true;
      fundirVelo(0, curva('in', 'base'));
      const a = animar(interior, { transform: afuera() }, curva('in', 'base'));
      await a.finished.catch(() => {});
      if (cerrando && panel.open) panel.close();
    };

    document.querySelectorAll<HTMLAnchorElement>('[data-abre-panel]').forEach((a) => {
      // Recién con JS el link abre un diálogo: antes es un link común a /hablemos/.
      a.setAttribute('aria-haspopup', 'dialog');
      a.addEventListener('click', (e) => {
        e.preventDefault();
        abrir();
      }, { signal });
    });
    panel.querySelector('[data-cierra-panel]')?.addEventListener('click', cerrarPanel, { signal });
    // Clic en el velo: el evento llega al <dialog> mismo (fuera del interior).
    panel.addEventListener('click', (e) => {
      if (e.target === panel) cerrarPanel();
    }, { signal });
    // Mientras se cierra, el foco no se mueve a lo que ya sale de pantalla.
    panel.addEventListener('keydown', (e) => {
      if (cerrando && e.key === 'Tab') e.preventDefault();
    }, { signal });
    panel.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrarPanel();
    }, { signal });
    panel.addEventListener('close', () => {
      cerrando = false;
      velo?.cancel();
      velo = null;
      [interior, ...campos].forEach((el) => {
        detener(el);
        el.style.opacity = '';
        el.style.transform = '';
      });
    }, { signal });

    // Copiar mail (M30 anima el cambio en la Fase 6; acá, el cambio de texto y el aviso).
    // M30 · "Copiar mail" sale hacia arriba y entra "Copiado ✓" en --color-success; vuelve a los
    // --hold-feedback. El aria-live anuncia el cambio.
    const copiar = panel.querySelector<HTMLButtonElement>('[data-copiar]');
    const texto = copiar?.querySelector<HTMLElement>('[data-copiar-texto]');
    let volver: number | undefined;
    const aviso = panel.querySelector('[data-copiar-estado]');
    copiar?.addEventListener('click', async () => {
      const mail = copiar.dataset['copiar'];
      if (!mail || !texto) return;
      try {
        await navigator.clipboard.writeText(mail);
      } catch {
        // Sin permiso de portapapeles: se anuncia y se muestra el mail para copiarlo a mano.
        const error = (copiar.dataset['textoError'] ?? '').replace('{mail}', mail);
        rodarTexto(texto, error);
        if (aviso) aviso.textContent = error;
        return;
      }
      // El color y la marca llegan con el texto nuevo (no sobre el que sale).
      rodarTexto(texto, copiar.dataset['textoOk'] ?? '').then(() => (copiar.dataset['estado'] = 'ok'));
      if (aviso) {
        aviso.textContent = '';
        requestAnimationFrame(() => (aviso.textContent = copiar.dataset['textoOk'] ?? ''));
      }
      window.clearTimeout(volver);
      volver = window.setTimeout(() => {
        rodarTexto(texto, copiar.dataset['texto'] ?? '', curva('out', 'fast'), -1).then(() => delete copiar.dataset['estado']);
        if (aviso) aviso.textContent = '';
      }, ms('--hold-feedback'));
    });
    return () => {
      ac.abort();
      window.clearTimeout(volver);
    };
  });
</script>

<style>
  .panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    inline-size: 100%;
    max-inline-size: none;
    block-size: var(--viewport-full);
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
  }

  .panel:not([open]) {
    display: none;
  }

  .panel::backdrop {
    background: var(--color-scrim);
  }

  .panel__interior {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    block-size: 100%;
    padding: calc(var(--safe-top) + var(--space-4)) var(--grid-margin) calc(var(--safe-bottom) + var(--space-6));
    background: var(--color-raised);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* 768 px o más: panel lateral derecho de 520 px. */
  @media (min-width: 48rem) {
    .panel {
      inset-inline-start: auto;
      inline-size: var(--drawer-width);
    }

    .panel__interior {
      padding-inline: var(--space-7);
    }
  }

  .panel__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--header-height);
  }

  .panel__cerrar {
    display: inline-grid;
    place-items: center;
    inline-size: var(--control-height);
    block-size: var(--control-height);
    margin-inline-end: calc(var(--space-3) * -1);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .panel__cerrar:hover {
      background: var(--color-surface);
    }
  }

  .panel__intro {
    color: var(--color-text-secondary);
  }

  .panel__directo {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline);
  }

  /* Geist Mono es solo para metadatos de formato (design system §4): el subtítulo va en Archivo. */
  .panel__subtitulo {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    line-height: var(--leading-ui);
  }

  .panel__directo ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel__directo li {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  /* Objetivo de 44 px en el link mismo, no solo en el ítem. */
  .panel__directo li > :global(*:not(.visually-hidden)) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .panel__mail {
    flex-wrap: wrap;
    column-gap: var(--space-4);
  }

  .panel__copiar {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .panel__copiar:disabled {
    color: var(--color-text-secondary);
    text-decoration-style: dotted;
    cursor: not-allowed;
  }

  .panel__copiar[data-estado="ok"] {
    color: var(--color-success);
  }

  .panel__copiar [data-copiar-texto] {
    display: inline-block;
  }

  /* "Copiado ✓": la marca es visual (el aviso ya dice "Copiado"). */
  .panel__copiar[data-estado="ok"] [data-copiar-texto]::after {
    content: " ✓" / "";
  }
</style>
