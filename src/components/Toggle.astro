---
/**
 * Toggles segmentados de 2 opciones · design system §7 (menú y footer).
 * - idioma: links ES / EN a la misma página; conserva la posición del scroll (PRD §5).
 * - modo: claro / oscuro. Respeta el sistema hasta que se elige; la elección se recuerda (localStorage 'tema').
 *   Varios toggles en la misma página se mantienen sincronizados.
 * - compacto (header, 24 nov): idioma como "ES / EN" y el modo como un switch con sol / luna.
 *   El header persiste entre páginas: los links de idioma se ponen al día en cada página.
 * M23 (View Transition del modo) y M24 (fundido del idioma) llegan en la Fase 6.
 */
import Icono from './Icono.astro';
import { t, locales, switchLangPath, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  tipo: 'idioma' | 'modo';
  compacto?: boolean;
}

const { lang, tipo, compacto = false } = Astro.props;
---

{
  tipo === 'modo' && compacto ? (
    <button class="tema-switch" type="button" role="switch" aria-checked="false" aria-label={t(lang, 'theme.darkMode')} data-switch-tema>
      <Icono nombre="luna" class="tema-switch__luna" />
      <Icono nombre="sol" class="tema-switch__sol" />
    </button>
  ) : tipo === 'idioma' ? (
    <nav class:list={['segmentado', { 'segmentado--compacto': compacto }]} aria-label={t(lang, 'lang.label')} data-toggle-idioma>
      {locales.map((l) => (
        <a
          class="segmentado__opcion"
          href={Astro.routePattern === '/404' ? localizePath(l) : switchLangPath(Astro.url, l)}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'true' : undefined}
        >
          {compacto ? (
            <>
              <span aria-hidden="true">{l.toUpperCase()}</span>
              <span class="visually-hidden">{t(l, `lang.${l}`)}</span>
            </>
          ) : (
            t(l, `lang.${l}`)
          )}
        </a>
      ))}
    </nav>
  ) : (
    <div class="segmentado" role="group" aria-label={t(lang, 'theme.label')} data-toggle-modo>
      <button class="segmentado__opcion" type="button" data-tema="light" aria-pressed="false">
        {t(lang, 'theme.light')}
      </button>
      <button class="segmentado__opcion" type="button" data-tema="dark" aria-pressed="false">
        {t(lang, 'theme.dark')}
      </button>
    </div>
  )
}

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { ScrollSmoother } from '../motion/gsap';

  // ---- Modo ----
  const sistema = matchMedia('(prefers-color-scheme: dark)');
  const temaActual = () => document.documentElement.dataset['theme'] ?? (sistema.matches ? 'dark' : 'light');

  const pintar = () => {
    const actual = temaActual();
    document.querySelectorAll<HTMLButtonElement>('[data-toggle-modo] [data-tema]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset['tema'] === actual));
    });
    document.querySelectorAll('[data-switch-tema]').forEach((b) => b.setAttribute('aria-checked', String(actual === 'dark')));
  };

  const cambiarTema = (tema: 'light' | 'dark') => {
    if (tema === temaActual()) return;
    const cambiar = () => {
      document.documentElement.dataset['theme'] = tema;
      try {
        localStorage.setItem('tema', tema);
      } catch {
        /* sin storage: el modo vale solo para esta página */
      }
      pintar();
    };
    // M23 · fundido cruzado de toda la página (300 · in-out); sin View Transitions, cambio directo.
    if (!document.startViewTransition) return cambiar();
    const html = document.documentElement;
    html.dataset['vt'] = 'tema';
    document.startViewTransition(cambiar).finished.finally(() => delete html.dataset['vt']);
  };

  /** El header persiste entre páginas: sus links de idioma apuntan a la página actual (hreflang del head). */
  const alDia = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-header] [data-toggle-idioma] a[hreflang]').forEach((a) => {
      const alterna = document.querySelector<HTMLLinkElement>(`link[rel="alternate"][hreflang="${a.hreflang}"]`);
      a.href = alterna ? new URL(alterna.href).pathname : `/${a.hreflang}/`;
    });
  };

  // ---- Idioma: misma página y misma posición ----
  const CLAVE = 'scroll-idioma';

  /** Tras cambiar de idioma, vuelve a la misma altura relativa. Con ClientRouter corre en
   *  astro:after-swap (después del scroll del router y antes de que se tome la vista nueva). */
  const restaurar = () => {
    try {
      const guardado = sessionStorage.getItem(CLAVE);
      if (!guardado) return;
      sessionStorage.removeItem(CLAVE);
      const { path, ratio } = JSON.parse(guardado) as { path: string; ratio: number };
      if (path === location.pathname && !location.hash) {
        const ir = () => {
          const y = ratio * (document.documentElement.scrollHeight - innerHeight);
          const smoother = ScrollSmoother.get();
          if (smoother) smoother.scrollTo(y, false);
          else scrollTo({ top: y, behavior: 'instant' });
        };
        ir();
        // Con ScrollSmoother el alto real llega cuando arranca el motion (page-load): se vuelve a ubicar ahí.
        document.addEventListener('astro:page-load', () => requestAnimationFrame(() => requestAnimationFrame(ir)), { once: true });
      }
      // El foco queda en el toggle (el del footer: el menú de la página nueva está cerrado), no al
      // principio de la página: quien usa teclado sigue donde estaba.
      document.querySelector<HTMLElement>('[data-header] [data-toggle-idioma] [aria-current]')?.focus({ preventScroll: true });
    } catch {
      /* nada que restaurar */
    }
  };
  restaurar();
  document.addEventListener('astro:after-swap', restaurar);

  enCadaPagina(() => {
    document.querySelectorAll<HTMLButtonElement>('[data-toggle-modo] [data-tema]').forEach((b) => {
      b.addEventListener('click', () => {
        const tema = b.dataset['tema'];
        if (tema === 'light' || tema === 'dark') cambiarTema(tema);
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-switch-tema]').forEach((b) => {
      // El header persiste: el listener se pone una sola vez.
      if (b.dataset['listo'] !== undefined) return;
      b.dataset['listo'] = '';
      b.addEventListener('click', () => cambiarTema(temaActual() === 'dark' ? 'light' : 'dark'));
    });
    pintar();
    alDia();

    document.querySelectorAll<HTMLAnchorElement>('[data-toggle-idioma] a:not([aria-current])').forEach((a) => {
      a.addEventListener('click', () => {
        const alto = document.documentElement.scrollHeight - innerHeight;
        try {
          sessionStorage.setItem(CLAVE, JSON.stringify({ path: new URL(a.href).pathname, ratio: alto > 0 ? scrollY / alto : 0 }));
        } catch {
          /* sin storage: se cambia de idioma igual, arriba de todo */
        }
      });
    });

    sistema.addEventListener('change', pintar);
    return () => sistema.removeEventListener('change', pintar);
  });
</script>

<style>
  .segmentado {
    display: inline-flex;
    padding: 2px;
    border: var(--border-control);
    border-radius: var(--radius-xs);
  }

  .segmentado__opcion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--control-height);
    min-inline-size: var(--control-height);
    padding-inline: var(--control-pad-x);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--text-ui);
    font-weight: var(--weight-ui);
    font-stretch: calc(var(--wdth-normal) * 1%);
    line-height: var(--leading-ui);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .segmentado__opcion:not([aria-current], [aria-pressed="true"]):hover {
      background: var(--color-surface);
      color: var(--color-text-primary);
    }
  }

  .segmentado__opcion[aria-current],
  .segmentado__opcion[aria-pressed="true"] {
    background: var(--color-text-primary);
    color: var(--color-bg);
    cursor: default;
  }

  .segmentado__opcion:focus-visible {
    outline-offset: var(--focus-offset);
  }

  .segmentado--compacto .segmentado__opcion {
    padding-inline: 0;
  }

  /* Switch de modo (header): un botón de 44 px; muestra la luna en claro y el sol en oscuro. */
  .tema-switch {
    display: inline-grid;
    place-items: center;
    inline-size: var(--control-height);
    block-size: var(--control-height);
    padding: 0;
    border: var(--border-control);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .tema-switch :global(.icono) {
    grid-area: 1 / 1;
  }

  .tema-switch[aria-checked="true"] :global(.tema-switch__luna),
  .tema-switch[aria-checked="false"] :global(.tema-switch__sol) {
    visibility: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .tema-switch:hover {
      background: var(--color-surface);
    }
  }

  .tema-switch:focus-visible {
    outline-offset: var(--focus-offset);
  }

  /* Alto contraste: la opción activa se marca con los colores del sistema. */
  @media (forced-colors: active) {
    .segmentado__opcion[aria-current],
    .segmentado__opcion[aria-pressed="true"] {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }
</style>
