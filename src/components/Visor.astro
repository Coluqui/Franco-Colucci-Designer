---
/**
 * Visor de piezas · design system §7 · PRD §6 · motion M08–M11.
 * <dialog> modal a pantalla completa sobre --color-inverse-bg (tokens invertidos con data-invertido).
 * - Un carrusel es UNA pieza: el contador doble dice "Pieza 03 / 12 · Slide 4 / 7".
 * - Slides en una pista con scroll-snap nativo (swipe, rueda); indicador segmentado.
 * - Teclado: ← → recorren slides y siguen a la pieza siguiente al terminar; Re Pág / Av Pág
 *   saltan de pieza; ESC cierra (nativo) y el foco vuelve al tile.
 * - Táctil: después del último slide, panel "Pieza siguiente →"; botones de pieza de 44 px.
 * - URL: ?pieza=<slug>&slide=4 (al cargar con esos parámetros, abre ahí). Sin autoplay.
 * - aria-live con "Slide 4 de 7"; alt por slide; aria-roledescription "carrusel".
 * - Performance: cada pieza vive en un <template>; solo se montan los slides de la pieza abierta
 *   y las imágenes son lazy (carga la actual y la siguiente).
 * PENDIENTE: el marco de teléfono para carruseles en desktop (PRD §6) necesita definición visual.
 * Fase 6: tile → visor con FLIP (M08), cierre (M09), segmento (M10) y cambio de pieza (M11).
 */
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { t, type Lang } from '../i18n';
import type { PiezaVista } from './tipos';

interface Props {
  lang: Lang;
  piezas: PiezaVista[];
}

const { lang, piezas } = Astro.props;
---

<dialog
  id="visor"
  class="visor"
  data-invertido
  aria-label={t(lang, 'viewer.label')}
  data-visor
  data-t-pieza={t(lang, 'viewer.piece')}
  data-t-slide={t(lang, 'viewer.slide')}
  data-t-slide-pos={t(lang, 'viewer.slidePosition')}
  data-t-pieza-pos={t(lang, 'viewer.piecePosition')}
>
  <div class="visor__barra">
    <p class="t-label visor__contador" aria-hidden="true" data-visor-contador></p>
    <button class="visor__boton" type="button" data-visor-cerrar autofocus aria-label={t(lang, 'viewer.close')}>
      <Icono nombre="cerrar" size="1.25rem" />
    </button>
  </div>

  <div class="visor__escena" role="group" aria-roledescription={t(lang, 'viewer.carousel')} aria-label={t(lang, 'viewer.label')} data-visor-escena>
    <button class="visor__boton visor__lado visor__lado--izq" type="button" data-visor-slide="-1" aria-label={t(lang, 'viewer.prevSlide')}>
      <Icono nombre="flecha-izq" size="1.25rem" />
    </button>
    <ul class="visor__pista" role="list" tabindex="-1" data-visor-pista></ul>
    <button class="visor__boton visor__lado visor__lado--der" type="button" data-visor-slide="1" aria-label={t(lang, 'viewer.nextSlide')}>
      <Icono nombre="flecha-der" size="1.25rem" />
    </button>
  </div>

  <div class="visor__pie">
    <ol class="visor__segmentos" role="list" data-visor-segmentos></ol>
    <div class="visor__piezas">
      <button class="visor__boton visor__boton--texto" type="button" data-visor-pieza="-1" aria-label={t(lang, 'viewer.prevPiece')}>
        <Icono nombre="flecha-izq" />
        <span class="visor__texto-corto" aria-hidden="true">{t(lang, 'viewer.prevShort')}</span>
        <span class="visor__texto-largo" aria-hidden="true">{t(lang, 'viewer.prevPiece')}</span>
      </button>
      <button class="visor__boton visor__boton--texto" type="button" data-visor-pieza="1" aria-label={t(lang, 'viewer.nextPiece')}>
        <span class="visor__texto-corto" aria-hidden="true">{t(lang, 'viewer.nextShort')}</span>
        <span class="visor__texto-largo" aria-hidden="true">{t(lang, 'viewer.nextPiece')}</span>
        <Icono nombre="flecha-der" />
      </button>
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-visor-estado></p>

  {
    piezas.map((p) => (
      <template data-visor-plantilla={p.slug} data-titulo={p.titulo}>
        {p.slides.map((s) => (
          <li class="visor__slide">
            <Image
              src={s.src}
              alt={s.alt}
              widths={[...new Set([480, 720, 1080, 1440].filter((w) => w < s.src.width).concat(Math.min(s.src.width, 1440)))]}
              sizes={`(min-width: 48rem) min(100vw, calc((100dvh - 12rem) * ${s.src.width / s.src.height})), 100vw`}
              loading="lazy"
            />
          </li>
        ))}
      </template>
    ))
  }
  <template data-visor-siguiente>
    <li class="visor__slide visor__slide--siguiente">
      <button class="visor__boton visor__boton--texto" type="button" data-visor-pieza="1">
        {t(lang, 'viewer.nextPanel')}
        <Icono nombre="flecha-der" />
      </button>
    </li>
  </template>
</dialog>

<script>
  import { alSalir, enCadaPagina } from '../scripts/pagina';
  import { animar, curva, detener, ms, numero, reducido, resorte } from '../scripts/motion/base';
  import { cajaContenida, hacia } from '../scripts/motion/flip';
  import { enPantalla } from '../scripts/motion/observer';

  /** Arrastre vertical que cierra el visor (M09): fracción del alto de la pantalla. */
  const UMBRAL_CIERRE = 0.2;

  enCadaPagina(() => {
    const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
    if (visor) {
      const pista = visor.querySelector<HTMLUListElement>('[data-visor-pista]')!;
      const contador = visor.querySelector('[data-visor-contador]')!;
      const estado = visor.querySelector('[data-visor-estado]')!;
      const segmentos = visor.querySelector('[data-visor-segmentos]')!;
      const escena = visor.querySelector('[data-visor-escena]')!;
      const cerrar = visor.querySelector<HTMLButtonElement>('[data-visor-cerrar]')!;
      const plantillas = [...visor.querySelectorAll<HTMLTemplateElement>('[data-visor-plantilla]')];
      const slugs = plantillas.map((p) => p.dataset['visorPlantilla'] ?? '');
      const siguientePanel = visor.querySelector<HTMLTemplateElement>('[data-visor-siguiente]')!;
      const d = visor.dataset;
      const dos = (n: number) => String(n).padStart(2, '0');
      const posSlide = (a: number, t: number) => (d['tSlidePos'] ?? '').replace('{actual}', String(a)).replace('{total}', String(t));
      const posPieza = (a: number, t: number) => (d['tPiezaPos'] ?? '').replace('{actual}', String(a)).replace('{total}', String(t));

      let pieza = 0;
      let slide = 0;
      let total = 0;
      /** Pieza hacia la que se va: se adelanta a `pieza` mientras la anterior sale (M11). */
      let objetivo = 0;
      let turno = 0;
      let cerrando = false;

      const slides = () => [...pista.querySelectorAll<HTMLElement>('.visor__slide:not(.visor__slide--siguiente)')];
      const panelFinal = () => pista.querySelector<HTMLElement>('.visor__slide--siguiente');
      const boton = (sel: string) => visor.querySelector<HTMLButtonElement>(sel);

      /** Si un control con foco se deshabilita, el foco pasa a su opuesto (o a Cerrar): nunca al body ni a algo invisible. */
      const deshabilitar = (b: HTMLButtonElement | null, inactivo: boolean, opuesto: string) => {
        if (!b) return;
        const teniaFoco = document.activeElement === b;
        b.disabled = inactivo;
        if (inactivo && teniaFoco) {
          const otro = boton(opuesto);
          (otro && !otro.disabled ? otro : cerrar).focus();
        }
      };

      /** Índices de las piezas que el filtro deja ver (la actual siempre cuenta, por si se abrió por enlace). */
      const visibles = () =>
        slugs
          .map((_, i) => i)
          .filter((i) => i === pieza || !document.querySelector(`[data-abre-visor="${slugs[i]}"]`)?.closest<HTMLElement>('[hidden]'));

      const actualizar = (anuncio: string | null) => {
        if (!visor.open) return;
        const lista = visibles();
        const n = lista.length;
        const pos = lista.indexOf(pieza);
        let texto = `${d['tPieza']} ${dos(pos + 1)} / ${dos(n)}`;
        if (total > 1) texto += ` · ${d['tSlide']} ${slide + 1} / ${total}`;
        contador.textContent = texto;
        segmentos.querySelectorAll('li').forEach((li, i) => {
          li.toggleAttribute('data-activo', i === slide);
          li.querySelector('button')?.setAttribute('aria-current', String(i === slide));
        });
        deshabilitar(boton('.visor__lado--izq'), slide === 0 && pos === 0, '.visor__lado--der');
        deshabilitar(boton('.visor__lado--der'), slide === total - 1 && pos === n - 1, '.visor__lado--izq');
        deshabilitar(boton('.visor__piezas [data-visor-pieza="-1"]'), pos === 0, '.visor__piezas [data-visor-pieza="1"]');
        deshabilitar(boton('.visor__piezas [data-visor-pieza="1"]'), pos === n - 1, '.visor__piezas [data-visor-pieza="-1"]');
        visor.toggleAttribute('data-un-slide', total < 2);
        const url = new URL(location.href);
        url.searchParams.set('pieza', slugs[pieza] ?? '');
        url.searchParams.set('slide', String(slide + 1));
        history.replaceState(history.state, '', url);
        if (anuncio !== null) estado.textContent = anuncio;
      };

      /** "Pieza 2 de 3 · Slide 1 de 5": al abrir y al cambiar de pieza se anuncian las dos cosas. */
      const titulo = () => plantillas[pieza]?.dataset['titulo'] ?? '';
      const anuncioCompleto = () => {
        const lista = visibles();
        const p = `${titulo()} · ${posPieza(lista.indexOf(pieza) + 1, lista.length)}`;
        return total > 1 ? `${p} · ${posSlide(slide + 1, total)}` : p;
      };

      /** `suave`: desliza (M10, según el CSS de la pista); al montar una pieza se salta sin animar. */
      const irSlide = (i: number, anunciar = true, suave = true) => {
        const destino = slides()[i];
        if (!destino) return;
        slide = i;
        pista.scrollTo({ left: destino.offsetLeft - pista.offsetLeft, behavior: suave ? 'auto' : 'instant' });
        actualizar(anunciar ? posSlide(slide + 1, total) : null);
      };

      const montar = (i: number, s = 0) => {
        // Si el foco estaba en la pista (panel final), se reubica después de reemplazarla.
        const focoEnPista = pista.contains(document.activeElement);
        pieza = Math.max(0, Math.min(slugs.length - 1, i));
        objetivo = pieza;
        pista.replaceChildren(plantillas[pieza]!.content.cloneNode(true));
        total = slides().length;
        escena.setAttribute('aria-label', titulo());
        const lista = visibles();
        if (lista.indexOf(pieza) < lista.length - 1 && total > 1) pista.append(siguientePanel.content.cloneNode(true));
        if (total > 1) slides().forEach((li, k) => li.setAttribute('aria-label', posSlide(k + 1, total)));
        // El panel final solo es alcanzable cuando el swipe llega a él (no se tabula fuera de vista).
        const panel = panelFinal();
        if (panel) {
          panel.inert = true;
          panel.querySelector('button')?.addEventListener('click', () => cambiarPieza(1));
        }
        // Segmentos: también son botones (44 px de área) para pasar de slide sin swipe (WCAG 2.5.7).
        segmentos.replaceChildren(
          ...Array.from({ length: total > 1 ? total : 0 }, (_, k) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.tabIndex = -1;
            b.setAttribute('aria-label', posSlide(k + 1, total));
            b.addEventListener('click', () => irSlide(k));
            li.append(b);
            return li;
          }),
        );
        irSlide(Math.max(0, Math.min(total - 1, s)), false, false);
        if (focoEnPista) {
          const sig = boton('.visor__piezas [data-visor-pieza="1"]');
          (sig && !sig.disabled ? sig : cerrar).focus();
        }
      };

      /**
       * M11 · otra pieza: la actual sale --shift-md hacia arriba (200 · in) y la nueva entra desde abajo
       * (--spring-snap). Vertical = otra pieza; horizontal = otro slide. Si llega otro pedido mientras
       * sale, el último manda. Reducido: los tokens lo dejan en un fundido de 120 ms.
       */
      const cambiarPieza = async (delta: number, alFinal = false) => {
        const lista = visibles();
        const nueva = lista[lista.indexOf(objetivo) + delta];
        if (nueva === undefined) return;
        objetivo = nueva;
        const mio = ++turno;
        const shift = numero('--shift-md');
        await animar(pista, { opacity: '0', transform: `translateY(${-shift}px)` }, curva('in', 'fast')).finished.catch(() => {});
        if (mio !== turno || !visor.open) return;
        montar(nueva, alFinal ? Number.MAX_SAFE_INTEGER : 0);
        actualizar(anuncioCompleto());
        pista.style.opacity = '';
        pista.style.transform = '';
        animar(pista, { opacity: '1', transform: 'none' }, {
          ...resorte('snap'),
          desde: { opacity: '0', transform: `translateY(${shift}px)` },
          soltar: true,
        });
      };

      const moverSlide = (delta: number) => {
        const nuevo = slide + delta;
        if (nuevo >= total) cambiarPieza(1);
        else if (nuevo < 0) cambiarPieza(-1, true);
        else irSlide(nuevo);
      };

      // ---- M08 / M09: la pieza viaja entre su tile y el visor ----
      const cromoTodo = [...visor.querySelectorAll<HTMLButtonElement | HTMLElement>('.visor__barra, .visor__pie, .visor__lado')];
      // Las flechas deshabilitadas ya son invisibles (CSS): no se animan, así no parpadean.
      const cromo = () => cromoTodo.filter((el) => !(el instanceof HTMLButtonElement && el.disabled));
      const imgActual = () => slides()[slide]?.querySelector('img') ?? null;
      const imgTile = () => document.querySelector<HTMLImageElement>(`[data-abre-visor="${slugs[pieza]}"] img`);
      let fondo: Animation | null = null;
      let tileOculto: HTMLImageElement | null = null;

      /** El fondo (--color-inverse-bg, en ::before) aparece o se va desde donde esté. */
      const fundirFondo = (hasta: number, opciones: { easing: string; duration: number }) => {
        const desde = fondo ? Number(getComputedStyle(visor, '::before').opacity) : 1 - hasta;
        fondo?.cancel();
        fondo = visor.animate({ opacity: [desde, hasta] }, { ...opciones, pseudoElement: '::before', fill: 'forwards' });
        return fondo;
      };

      /** El tile queda vacío mientras su pieza está en el visor: nunca hay dos copias a la vista. */
      const ocultarTile = (img: HTMLImageElement | null) => {
        if (tileOculto && tileOculto !== img) tileOculto.style.opacity = '';
        tileOculto = img;
        if (img) img.style.opacity = '0';
      };

      /** ¿Hay un tile a la vista al que la pieza pueda volver (o del que pueda salir)? */
      const tileVisible = () => {
        const t = imgTile();
        return t && t.offsetParent && enPantalla(t) ? t : null;
      };

      /** La pieza (no su caja: el visor la muestra con contain) se lleva a `destino`. */
      const hastaTile = (img: HTMLImageElement, destino: DOMRect) => {
        img.style.transform = '';
        img.style.transformOrigin = '0 0';
        return hacia(img, cajaContenida(img), destino);
      };

      /** M08 · 560 · snap. Fondo en 300 · out; contador y controles 200 ms después. Reducido: fundido de 120 ms. */
      const entrarVisor = () => {
        cerrando = false;
        fundirFondo(1, curva('out', 'base'));
        cromo().forEach((el) =>
          animar(el, { opacity: '1' }, { ...curva('out', 'fast'), delay: ms('--duration-fast'), desde: { opacity: '0' }, soltar: true }),
        );
        const img = imgActual();
        const tile = tileVisible();
        if (!img) return;
        if (tile && !reducido()) {
          detener(img);
          const actual = img.style.transform;
          const desde = hastaTile(img, tile.getBoundingClientRect());
          animar(img, { transform: 'none' }, { ...resorte('snap'), desde: { transform: actual || desde }, soltar: true });
        } else {
          animar(img, { opacity: '1' }, { ...curva('out', 'base'), desde: { opacity: '0' }, soltar: true });
        }
        ocultarTile(imgTile());
      };

      /**
       * M09 · cerrar (ESC, ×, arrastre vertical): la pieza vuelve a su tile si está a la vista
       * (700 · soft); si no, el visor se funde. El fondo se va en 300 · in. Después, el foco vuelve al tile.
       */
      const cerrarVisor = async () => {
        if (!visor.open || cerrando) return;
        cerrando = true;
        turno++;
        fundirFondo(0, curva('in', 'base'));
        cromo().forEach((el) => animar(el, { opacity: '0' }, curva('in', 'fast')));
        const img = imgActual();
        const tile = tileVisible();
        let principal: Animation;
        if (img && tile && !reducido()) {
          detener(img);
          const actual = img.style.transform || 'none';
          const destino = hastaTile(img, tile.getBoundingClientRect());
          principal = animar(img, { transform: destino }, { ...resorte('soft'), desde: { transform: actual } });
        } else {
          ocultarTile(null);
          principal = animar(pista, { opacity: '0' }, curva('in', 'base'));
        }
        await principal.finished.catch(() => {});
        if (cerrando && visor.open) visor.close();
      };

      const abrir = (slug: string, s = 0) => {
        const i = slugs.indexOf(slug);
        if (i < 0) return;
        const recienAbierto = !visor.open || cerrando;
        if (!visor.open) visor.showModal();
        montar(i, s);
        actualizar(null);
        if (recienAbierto) entrarVisor();
        if (recienAbierto) requestAnimationFrame(() => (estado.textContent = anuncioCompleto()));
        else estado.textContent = anuncioCompleto();
      };

      // Abridores: los tiles (links a la imagen grande, para cuando no hay JS).
      document.querySelectorAll<HTMLAnchorElement>('[data-abre-visor]').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault();
          abrir(a.dataset['abreVisor'] ?? '');
        }),
      );

      cerrar.addEventListener('click', cerrarVisor);
      // ESC: el visor se cierra con su animación (si el navegador igual lo cierra, el evento close limpia).
      visor.addEventListener('cancel', (e) => {
        e.preventDefault();
        cerrarVisor();
      });

      // Táctil: arrastrar la pieza hacia arriba o abajo la cierra; si no llega, vuelve (el dedo manda).
      let arrastre: { id: number; x: number; y: number; activo: boolean; dy: number } | null = null;
      escena.addEventListener('pointerdown', (e) => {
        const ev = e as PointerEvent;
        if (ev.pointerType !== 'touch' || cerrando) return;
        arrastre = { id: ev.pointerId, x: ev.clientX, y: ev.clientY, activo: false, dy: 0 };
      });
      escena.addEventListener('pointermove', (e) => {
        const ev = e as PointerEvent;
        const img = imgActual();
        if (!arrastre || ev.pointerId !== arrastre.id || !img) return;
        const dx = ev.clientX - arrastre.x;
        const dy = ev.clientY - arrastre.y;
        if (!arrastre.activo) {
          if (Math.abs(dy) < numero('--shift-sm') || Math.abs(dy) < Math.abs(dx)) return;
          arrastre.activo = true;
          detener(img);
          fondo?.cancel();
          // El fondo sigue al dedo: una animación en pausa que se recorre con currentTime (0 a 1).
          fondo = visor.animate({ opacity: [1, 0] }, { duration: 1, pseudoElement: '::before', fill: 'both' });
          fondo.pause();
        }
        arrastre.dy = dy;
        img.style.transform = `translateY(${dy}px)`;
        if (fondo) fondo.currentTime = Math.min(1, Math.abs(dy) / innerHeight);
      });
      const soltarArrastre = (e: Event) => {
        const ev = e as PointerEvent;
        if (!arrastre || ev.pointerId !== arrastre.id) return;
        const { activo, dy } = arrastre;
        arrastre = null;
        if (!activo) return;
        if (e.type === 'pointerup' && Math.abs(dy) > innerHeight * UMBRAL_CIERRE) cerrarVisor();
        else {
          const img = imgActual();
          if (img) {
            // Vuelve desde donde la dejó el dedo y termina en su CSS (sin estilo en línea).
            const desde = { transform: img.style.transform || 'none' };
            img.style.transform = '';
            animar(img, { transform: 'none' }, { ...resorte('soft'), desde, soltar: true });
          }
          fundirFondo(1, resorte('soft'));
        }
      };
      escena.addEventListener('pointerup', soltarArrastre);
      escena.addEventListener('pointercancel', soltarArrastre);
      visor.querySelectorAll<HTMLButtonElement>('[data-visor-slide]').forEach((b) =>
        b.addEventListener('click', () => moverSlide(Number(b.dataset['visorSlide']))),
      );
      visor.querySelectorAll<HTMLButtonElement>('.visor__piezas [data-visor-pieza]').forEach((b) =>
        b.addEventListener('click', () => cambiarPieza(Number(b.dataset['visorPieza']))),
      );

      // En document y no en el dialog: el teclado sigue andando aunque el foco quede en cualquier lado.
      const alTeclado = (e: KeyboardEvent) => {
        if (!visor.open) return;
        const map: Record<string, () => void> = {
          ArrowRight: () => moverSlide(1),
          ArrowLeft: () => moverSlide(-1),
          PageDown: () => cambiarPieza(1),
          PageUp: () => cambiarPieza(-1),
        };
        const accion = map[e.key];
        if (accion) {
          e.preventDefault();
          accion();
        }
      };
      document.addEventListener('keydown', alTeclado);
      alSalir(() => document.removeEventListener('keydown', alTeclado));

      // Swipe / rueda: el slide más visible pasa a ser el actual; el panel final se habilita al llegar.
      pista.addEventListener('scrollend', () => {
        const ancho = pista.clientWidth || 1;
        const i = Math.round(pista.scrollLeft / ancho);
        const panel = panelFinal();
        if (panel) panel.inert = i !== total;
        if (i !== slide && i < total) {
          slide = i;
          actualizar(posSlide(slide + 1, total));
        }
      });

      visor.addEventListener('close', () => {
        cerrando = false;
        turno++;
        fondo?.cancel();
        fondo = null;
        ocultarTile(null);
        [...cromoTodo, pista].forEach((el) => {
          detener(el);
          el.style.opacity = '';
          el.style.transform = '';
        });
        // El foco vuelve al tile de la pieza que se estaba viendo (también al abrir por enlace directo).
        const tile = document.querySelector<HTMLElement>(`[data-abre-visor="${slugs[pieza]}"]`);
        if (tile && tile.offsetParent) tile.focus();
        else document.querySelector<HTMLElement>('#contenido')?.focus();
        pista.replaceChildren();
        const url = new URL(location.href);
        url.searchParams.delete('pieza');
        url.searchParams.delete('slide');
        history.replaceState(history.state, '', url);
      });

      // Enlace directo: ?pieza=<slug>&slide=4
      const params = new URL(location.href).searchParams;
      const inicial = params.get('pieza');
      if (inicial) abrir(inicial, Math.max(0, Number(params.get('slide') ?? 1) - 1));
    }
  });
</script>

<style>
  .visor {
    position: fixed;
    inset: 0;
    z-index: var(--z-viewer);
    inline-size: 100%;
    max-inline-size: none;
    block-size: var(--viewport-full);
    max-block-size: none;
    margin: 0;
