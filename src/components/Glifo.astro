---
/**
 * Monograma "FC" (Franco, 24 nov: reemplaza al cuadrado provisorio del glifo "Formato").
 * Letras reales en Archivo black ancha, no un dibujo. `size` es el ancho del monograma.
 * Siempre es decorativo (aria-hidden): el texto accesible lo pone quien lo usa.
 */
interface Props {
  /** Ancho en cualquier unidad CSS. */
  size?: string;
  class?: string;
}

const { size = '1.625rem', class: className } = Astro.props;
---

<span class:list={['glifo', className]} style={`--glifo-size: ${size}`} aria-hidden="true">FC</span>

<style>
  /* "FC" en Archivo 800 a wdth 125 mide ~1,45 em de ancho: el cuerpo sale del ancho pedido. */
  .glifo {
    display: inline-block;
    flex: none;
    font-size: calc(var(--glifo-size) / 1.45);
    font-weight: var(--weight-black);
    font-stretch: calc(var(--wdth-wide) * 1%);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: inherit;
    white-space: nowrap;
  }
</style>
