---
/**
 * Cierre de la home · PRD §3 y §5 · design system §3 (sección invertida).
 * La frase-problema vuelve como cierre + "▣ Hablemos" (abre el panel; sin JS, /[lang]/hablemos/).
 * El enorme vive en el Footer, que viene justo después.
 * El botón va en versión grande (--text-h3): junto al titular display, el de 44 px se perdía (auditoría 25 nov).
 */
import Boton from './Boton.astro';
import FraseProblema from './FraseProblema.astro';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="seccion-invertida cierre" aria-labelledby="cierre-titulo">
  <div class="container cierre__caja">
    <FraseProblema texto={t(lang, 'closing.text')} as="h2" id="cierre-titulo" />
    <Boton href={localizePath(lang, 'hablemos/')} data-abre-panel>
      {t(lang, 'nav.talk')}
    </Boton>
  </div>
</section>

<style>
  .cierre {
    padding-block: var(--space-section);
  }

  .cierre__caja {
    display: grid;
    justify-items: start;
    gap: var(--space-8);
  }

  .cierre__caja :global(.boton) {
    min-block-size: calc(var(--control-height) + var(--space-4));
    padding-inline: var(--space-6);
    font-size: var(--text-h3);
  }
</style>
