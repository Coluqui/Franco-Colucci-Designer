---
/**
 * Filtros (Trabajos: por servicio · caso: por formato) · design system §7 · PRD §3, §6 y §7.
 * Chips de texto con aria-pressed: inactivo con --border-control; activo con fondo
 * --color-text-primary y un punto cobalto; hover --color-surface. Muestran la cantidad ("Ads · 4";
 * un carrusel cuenta 1: la cantidad la calcula quien usa el componente).
 * Filtra los elementos con [data-filtro] dentro de #objetivo (valores separados por espacio)
 * con `hidden`, guarda el valor en la URL (?param=valor) y anuncia "{n} piezas" (aria-live).
 * Sin JS no se muestran: todo queda visible. Fase 6: reacomodo FLIP (M12) y punto que encastra.
 */
import { t, tf, type Lang } from '../i18n';

interface Opcion {
  valor: string;
  nombre: string;
  cantidad: number;
}

interface Props {
  lang: Lang;
  /** "Filtrar por servicio" / "Filtrar por formato". */
  etiqueta: string;
  opciones: Opcion[];
  /** id del contenedor de los elementos a filtrar. */
  objetivo: string;
  /** Parámetro de la URL: servicio | formato. */
  param: string;
  total: number;
  /** Qué se cuenta: piezas (caso) o casos (Trabajos). */
  unidad?: 'piezas' | 'casos';
}

const { lang, etiqueta, opciones, objetivo, param, total, unidad = 'piezas' } = Astro.props;
const claveVarios = unidad === 'casos' ? 'filters.resultsCases' : 'filters.results';
const claveUno = unidad === 'casos' ? 'filters.resultsCasesOne' : 'filters.resultsOne';
const todas: Opcion = { valor: '', nombre: t(lang, 'filters.all'), cantidad: total };
---

<div
  class="filtros"
  role="group"
  aria-labelledby={`filtros-${objetivo}`}
  data-filtros
  data-objetivo={objetivo}
  data-param={param}
  data-texto-uno={t(lang, claveUno)}
  data-texto-varios={t(lang, claveVarios)}
>
  <p class="filtros__etiqueta t-dato" id={`filtros-${objetivo}`}>{etiqueta}</p>
  <ul role="list">
    {
      [todas, ...opciones].map((o) => (
        <li>
          <button class="filtro" type="button" aria-pressed={o.valor === '' ? 'true' : 'false'} data-valor={o.valor}>
            <span class="filtro__fondo" aria-hidden="true" />
            <span class="filtro__punto" aria-hidden="true" />
            <span class="filtro__nombre">{o.nombre}</span>
            <span class="filtro__cantidad" aria-hidden="true">· {o.cantidad}</span>
            <span class="visually-hidden">
              {o.cantidad === 1 ? t(lang, claveUno) : tf(lang, claveVarios, { n: o.cantidad })}
            </span>
          </button>
        </li>
      ))
    }
  </ul>
  <p class="visually-hidden" aria-live="polite" data-filtros-estado></p>
</div>

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { animar, curva, detener, ms, reducido, resorte } from '../motion/micro';

  /**
   * M12 · el fondo del filtro activo y su punto viajan al nuevo (FLIP, --spring-snap). En la grilla,
   * lo que queda se reacomoda (FLIP, --spring-soft), lo que sale se desvanece fuera del flujo y lo
   * que entra aparece con --stagger-fast. Reducido: cambio instantáneo (rama permitida para FLIP).
   */
  const viajarActivo = (antes: HTMLButtonElement | undefined, ahora: HTMLButtonElement | undefined) => {
    if (!antes || !ahora || antes === ahora || reducido()) return;
    const fondoAntes = antes.querySelector<HTMLElement>('.filtro__fondo')!.getBoundingClientRect();
    const puntoAntes = antes.querySelector<HTMLElement>('.filtro__punto')!.getBoundingClientRect();
    const fondo = ahora.querySelector<HTMLElement>('.filtro__fondo')!;
    const punto = ahora.querySelector<HTMLElement>('.filtro__punto')!;
    // Si todavía viajaban (clics rápidos), se mide su lugar real, no el desplazado.
    [fondo, punto].forEach((el) => {
      detener(el);
      el.style.transform = '';
    });
    const f = fondo.getBoundingClientRect();
    const p = punto.getBoundingClientRect();
    // El fondo es un rectángulo de color (no una pieza): puede cambiar de ancho al viajar.
    const desdeFondo = `translate(${fondoAntes.left - f.left}px, ${fondoAntes.top - f.top}px) scale(${fondoAntes.width / f.width}, ${fondoAntes.height / f.height})`;
    animar(fondo, { transform: 'none' }, { ...resorte('snap'), desde: { transform: desdeFondo }, soltar: true });
    // El punto no se deforma: solo se traslada.
    const desdePunto = `translate(${puntoAntes.left - p.left}px, ${puntoAntes.top - p.top}px)`;
    animar(punto, { transform: 'none' }, { ...resorte('snap'), desde: { transform: desdePunto }, soltar: true });
  };

  /** Lo que sale queda fuera del flujo (en su lugar) mientras se desvanece; después, hidden. */
  const salientes = new Map<HTMLElement, Animation>();

  const terminarSalida = (el: HTMLElement) => {
    salientes.get(el)?.cancel();
    salientes.delete(el);
    el.inert = false;
    for (const p of ['position', 'insetInlineStart', 'insetBlockStart', 'inlineSize', 'opacity'] as const) el.style[p] = '';
  };

  const reacomodar = (objetivo: HTMLElement, quedan: (el: HTMLElement) => boolean) => {
    const items = [...objetivo.querySelectorAll<HTMLElement>('[data-filtro]')];
    // Si había salidas a medias, terminan ya (el nuevo pedido manda).
    items.forEach((el) => salientes.has(el) && (terminarSalida(el), (el.hidden = true)));

    if (reducido()) {
      items.forEach((el) => (el.hidden = !quedan(el)));
      return;
    }
    if (getComputedStyle(objetivo).position === 'static') objetivo.style.position = 'relative';
    const antes = new Map(items.filter((el) => !el.hidden).map((el) => [el, el.getBoundingClientRect()]));
    const contenedor = objetivo.getBoundingClientRect();
    const salen = items.filter((el) => !el.hidden && !quedan(el));
    const entran = items.filter((el) => el.hidden && quedan(el));
    // Si se estaban reacomodando o entrando, se sigue desde lo que se ve: el FLIP parte de `antes` (no
    // del desplazamiento viejo) y una entrada a medias termina de aparecer desde su opacidad actual.
    const opacidad = new Map<HTMLElement, string>();
    antes.forEach((_, el) => {
      detener(el);
      if (el.style.opacity) opacidad.set(el, el.style.opacity);
      el.style.transform = '';
      el.style.opacity = '';
    });

    // Las que salen: fuera del flujo, en el mismo lugar, para que el resto pueda reacomodarse.
    salen.forEach((el) => {
      const r = antes.get(el)!;
      el.inert = true;
      Object.assign(el.style, {
        position: 'absolute',
        insetInlineStart: `${r.left - contenedor.left}px`,
        insetBlockStart: `${r.top - contenedor.top}px`,
        inlineSize: `${r.width}px`,
      });
    });
    entran.forEach((el) => (el.hidden = false));

    // Las que quedan: FLIP (misma medida, solo se trasladan).
    antes.forEach((r, el) => {
      if (salen.includes(el)) return;
      const d = el.getBoundingClientRect();
      const dx = r.left - d.left;
      const dy = r.top - d.top;
      const desde: Keyframe = {};
      const hasta: Keyframe = {};
      if (Math.abs(dx) >= 0.5 || Math.abs(dy) >= 0.5) {
        desde['transform'] = `translate(${dx}px, ${dy}px)`;
        hasta['transform'] = 'none';
      }
      const o = opacidad.get(el);
      if (o) {
        desde['opacity'] = o;
        hasta['opacity'] = '1';
      }
      if (Object.keys(hasta).length) animar(el, hasta, { ...resorte('soft'), desde, soltar: true });
    });

    salen.forEach((el) => {
      const a = animar(el, { opacity: '0' }, curva('in', 'fast'));
      salientes.set(el, a);
      a.finished
        .then(() => {
          if (salientes.get(el) !== a) return;
          terminarSalida(el);
          el.hidden = true;
        })
        .catch(() => {});
    });

    const paso = ms('--stagger-fast');
    entran.forEach((el, k) =>
      animar(el, { opacity: '1' }, { ...resorte('soft'), delay: k * paso, desde: { opacity: '0' }, soltar: true }),
    );
  };

  enCadaPagina(() => {
    document.querySelectorAll<HTMLElement>('[data-filtros]').forEach((grupo) => {
      const objetivo = document.getElementById(grupo.dataset['objetivo'] ?? '');
      const param = grupo.dataset['param'] ?? 'filtro';
      const estado = grupo.querySelector('[data-filtros-estado]');
      const botones = [...grupo.querySelectorAll<HTMLButtonElement>('.filtro')];
      if (!objetivo) return;
      grupo.dataset['listo'] = '';

      const aplicar = (valor: string, anunciar: boolean) => {
        if (!botones.some((b) => b.dataset['valor'] === valor)) valor = '';
        const previo = botones.find((b) => b.getAttribute('aria-pressed') === 'true');
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset['valor'] === valor)));
        const quedan = (el: HTMLElement) => valor === '' || (el.dataset['filtro'] ?? '').split(' ').includes(valor);
        const visibles = [...objetivo.querySelectorAll<HTMLElement>('[data-filtro]')].filter(quedan).length;
        if (anunciar) {
          viajarActivo(previo, botones.find((b) => b.dataset['valor'] === valor));
          reacomodar(objetivo, quedan);
        } else {
          objetivo.querySelectorAll<HTMLElement>('[data-filtro]').forEach((el) => (el.hidden = !quedan(el)));
        }
        const url = new URL(location.href);
        if (valor) url.searchParams.set(param, valor);
        else url.searchParams.delete(param);
        history.replaceState(history.state, '', url);
        if (anunciar && estado) {
          const plantilla = (visibles === 1 ? grupo.dataset['textoUno'] : grupo.dataset['textoVarios']) ?? '';
          // Se vacía y se escribe en el cuadro siguiente: un anuncio igual al anterior también se lee.
          estado.textContent = '';
          requestAnimationFrame(() => (estado.textContent = plantilla.replace('{n}', String(visibles))));
        }
      };

      botones.forEach((b) =>
        b.addEventListener('click', () => {
          if (b.getAttribute('aria-pressed') === 'true') return;
          aplicar(b.dataset['valor'] ?? '', true);
        }),
      );
      aplicar(new URL(location.href).searchParams.get(param) ?? '', false);
    });
    return () => salientes.forEach((_, el) => terminarSalida(el));
  });
</script>

<style>
  /* Sin JS no hay filtros. Con JS ocupan su lugar desde el primer cuadro (data-js se pone antes de
     pintar, en Base.astro): si esperaran al script, empujarían la lista al aparecer (CLS). */
  :global(:root:not([data-js])) .filtros {
    display: none;
  }

  .filtros {
    display: grid;
    gap: var(--space-3);
  }

  .filtros__etiqueta {
    margin: 0;
  }

  .filtros ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .filtro {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--control-height-sm);
    padding-inline: var(--control-pad-x);
    border: var(--border-control);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-primary);
    font-size: var(--text-ui);
    font-weight: var(--weight-ui);
    line-height: var(--leading-ui);
    white-space: nowrap;
    cursor: pointer;
    /* El color del texto cambia a mitad del viaje del fondo (M12): nunca texto claro sobre claro. */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out) calc(var(--spring-snap-duration) / 2);
  }

  /* Los textos van encima de cualquier fondo, también del que viaja desde otro filtro
     (sin isolation: todos los fondos y textos del grupo comparten capa). */
  .filtro__punto,
  .filtro__nombre,
  .filtro__cantidad {
    position: relative;
    z-index: 1;
  }

  /* Fondo del activo: una capa propia (debajo del texto) para que pueda viajar de un filtro a otro (M12). */
  .filtro__fondo {
    position: absolute;
    inset: 0; /* el borde del activo ya es --color-text-primary: juntos se ven como un solo bloque */
    z-index: 0;
    border-radius: inherit;
    background: var(--color-text-primary);
    opacity: 0;
    transform-origin: 0 0;
  }

  /* Área táctil de 44 px sobre un chip de 36. */
  .filtro::before {
    content: "";
    position: absolute;
    inset-block: calc((var(--control-height-sm) - var(--control-height)) / 2);
    inset-inline: 0;
  }

  .filtro__cantidad {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .filtro__punto {
    display: none;
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-radius: var(--radius-full);
    /* Sobre fondo --color-text-primary: el acento inverso (como el chip en secciones invertidas). */
    background: var(--color-inverse-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .filtro[aria-pressed="false"]:hover {
      background: var(--color-surface);
    }
  }

  .filtro[aria-pressed="true"] {
    border-color: var(--color-text-primary);
    color: var(--color-bg);
  }

  .filtro[aria-pressed="true"] .filtro__fondo {
    opacity: 1;
  }

  .filtro[aria-pressed="true"] .filtro__cantidad {
    color: inherit;
  }

  .filtro[aria-pressed="true"] .filtro__punto {
    display: block;
  }

  /* Alto contraste: el activo se marca con los colores del sistema (el fondo se fuerza a Canvas). */
  @media (forced-colors: active) {
    .filtro[aria-pressed="true"] {
      forced-color-adjust: none;
      border-color: Highlight;
      background: Highlight;
      color: HighlightText;
    }

    .filtro__fondo,
    .filtro[aria-pressed="true"] .filtro__punto {
      display: none;
    }

    .filtro[aria-pressed="true"] .filtro__cantidad {
      color: HighlightText;
    }
  }
</style>
