---
/**
 * Menú a pantalla completa · design system §7 · PRD §5.
 * <dialog> modal: foco atrapado e inerte el resto (nativo), ESC cierra, el foco vuelve a "Menú".
 * Links en --text-services: wdth 112 en reposo, 125 en hover/foco y en la página actual.
 * A la derecha: mail, LinkedIn, WhatsApp, CV y toggles ES/EN y modo.
 * 4.10: al abrir, los links suben y pasan de desenfocados a nítidos, escalonados (GSAP); en hover,
 * el link pasa a 125 y el resto queda en 112. El menú crece desde el botón "Menú" y los links
 * entran cuando llega al 60 %.
 */
import Boton from './Boton.astro';
import Glifo from './Glifo.astro';
import Link from './Link.astro';
import Toggle from './Toggle.astro';
import { t, localizePath, type Lang, type UiKey } from '../i18n';
import { site, mailHref, linkedinHref, whatsappHref, cvHref } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const actual = Astro.url.pathname;

const links: Array<{ clave: UiKey; href: string }> = [
  { clave: 'nav.home', href: localizePath(lang) },
  { clave: 'nav.work', href: localizePath(lang, 'trabajos/') },
  { clave: 'nav.about', href: localizePath(lang, 'sobre-mi/') },
];
---

<dialog id="menu" class="menu" aria-label={t(lang, 'nav.menu')} data-menu>
  <div class="menu__barra container">
    <a class="menu__logo" href={localizePath(lang)} aria-label={t(lang, 'nav.homeLink')}>
      <Glifo size="1.625rem" />
    </a>
    <Boton variante="secundario" size="sm" data-cierra-menu autofocus>{t(lang, 'nav.close')}</Boton>
  </div>

  <div class="menu__cuerpo container">
    <nav class="menu__nav" aria-label={t(lang, 'nav.label')}>
      <ul role="list">
        {
          links.map(({ clave, href }) => (
            <li>
              <a class="menu__link t-services" href={href} aria-current={actual === href || (clave === 'nav.work' && actual.startsWith(href)) ? 'page' : undefined}>
                {t(lang, clave)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu__lateral">
      <section aria-label={t(lang, 'nav.contact')}>
        <ul class="menu__contacto" role="list">
          <li><Link href={mailHref()} lang={lang}>{site.mail ?? t(lang, 'contact.email')}</Link></li>
          <li><Link href={linkedinHref()} lang={lang} externo>{t(lang, 'contact.linkedin')}</Link></li>
          <li><Link href={whatsappHref()} lang={lang} externo>{t(lang, 'contact.whatsapp')}</Link></li>
          <li><Link href={cvHref(lang)} lang={lang} download>{t(lang, 'contact.downloadCv')}</Link></li>
        </ul>
      </section>
      <div class="menu__toggles">
        <Toggle lang={lang} tipo="idioma" />
        <Toggle lang={lang} tipo="modo" />
      </div>
    </div>
  </div>
</dialog>

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { gsap } from '../motion/gsap';
  import { dur, ease, mov, stagger } from '../motion/tokens';
  import { animar, curva, detener, numero, resorte, token } from '../motion/micro';

  /**
   * M20 · el menú crece desde el botón "Menú": el rectángulo del botón cambia de formato hasta cubrir
   * la pantalla (clip-path: inset(), radio --radius-xs → 0, --spring-snap). Al 60 % entran los links
   * (M14). "Menú" ↔ "Cerrar" con roll vertical. Cerrar: vuelve a meterse en el botón (300 · in) y el
   * foco vuelve a "Menú" (nativo del <dialog>).
   */
  enCadaPagina(() => {
    const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
    const abridores = [...document.querySelectorAll<HTMLElement>('[data-abre-menu]')];
    if (!menu) return;
    // El header persiste entre páginas: sus escuchas se sueltan al salir (si no, se acumulan).
    const ac = new AbortController();
    const signal = ac.signal;
    const links = [...menu.querySelectorAll<HTMLElement>('.menu__link')];
    const cerrar = menu.querySelector<HTMLElement>('[data-cierra-menu]');
    const etiquetaCerrar = cerrar?.querySelector<HTMLElement>('.boton__texto') ?? null;
    let origen: HTMLElement | null = null;
    let cerrando = false;

    const marcar = (abierto: boolean) => abridores.forEach((b) => b.setAttribute('aria-expanded', String(abierto)));
    marcar(false);

    /** El recorte que deja ver solo la caja de `el` (o null si no se ve). */
    const recorteDe = (el: HTMLElement | null) => {
      const r = el?.getBoundingClientRect();
      if (!r || !r.width) return null;
      const m = menu.getBoundingClientRect();
      return `inset(${r.top - m.top}px ${m.right - r.right}px ${m.bottom - r.bottom}px ${r.left - m.left}px round ${token('--radius-xs')})`;
    };
    const completo = 'inset(0px 0px 0px 0px round 0px)';

    /** Roll vertical de una etiqueta: entra desde abajo (abrir) o sale hacia abajo (cerrar). */
    const rollar = (el: HTMLElement | null, entra: boolean) => {
      if (!el) return;
      const fuera = { opacity: '0', transform: `translateY(${numero('--shift-sm')}px)` };
      if (entra) animar(el, { opacity: '1', transform: 'none' }, { ...resorte('snap'), desde: fuera, soltar: true });
      else animar(el, fuera, curva('in', 'fast'));
    };

    /** 4.10 · links: yPercent 100 → 0 y blur → nítido, stagger.items, ease.expo. Reducido: fundido corto. */
    const entrarLinks = (retrasoMs: number) => {
      gsap.killTweensOf(links);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.fromTo(links, { opacity: 0 }, { opacity: 1, duration: dur.reducido, ease: 'none', clearProps: 'opacity' });
        return;
      }
      gsap.fromTo(
        links,
        { yPercent: 100, opacity: 0, filter: `blur(${mov.blurMenu}px)` },
        { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: dur.base, ease: ease.expo, stagger: stagger.items, delay: retrasoMs / 1000, clearProps: 'transform,opacity,filter' },
      );
    };

    const abrir = (boton: HTMLElement) => {
      origen = boton;
      cerrando = false;
      if (!menu.open) menu.showModal();
      marcar(true);
      const snap = resorte('snap');
      const desde = recorteDe(boton);
      if (desde) animar(menu, { clipPath: completo }, { ...snap, desde: { clipPath: desde }, soltar: true });
      else animar(menu, { opacity: '1' }, { ...curva('out', 'base'), desde: { opacity: '0' }, soltar: true });
      rollar(etiquetaCerrar, true);
      entrarLinks(snap.duration * 0.6);
    };

    const cerrarMenu = async () => {
      if (!menu.open || cerrando) return;
      cerrando = true;
      rollar(etiquetaCerrar, false);
      const hasta = recorteDe(origen);
      const a = hasta
        ? animar(menu, { clipPath: hasta }, curva('in', 'base'))
        : animar(menu, { opacity: '0' }, curva('in', 'base'));
      await a.finished.catch(() => {});
      if (cerrando && menu.open) menu.close();
    };

    abridores.forEach((b) => b.addEventListener('click', () => abrir(b), { signal }));
    cerrar?.addEventListener('click', cerrarMenu, { signal });
    // ESC: el menú se cierra con su animación (si el navegador igual lo cierra, close limpia).
    // Mientras se cierra, el foco no se mueve a lo que ya se está escondiendo.
    menu.addEventListener('keydown', (e) => {
      if (cerrando && e.key === 'Tab') e.preventDefault();
    }, { signal });
    menu.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrarMenu();
    }, { signal });
    menu.addEventListener('close', () => {
      cerrando = false;
      [menu, etiquetaCerrar].forEach((el) => {
        if (!el) return;
        detener(el);
        el.style.clipPath = '';
        el.style.opacity = '';
        el.style.transform = '';
      });
      gsap.killTweensOf(links);
      gsap.set(links, { clearProps: 'transform,opacity,filter' });
      marcar(false);
      // "Menú" vuelve con su roll.
      rollar(origen?.querySelector<HTMLElement>('.boton__texto') ?? null, true);
    }, { signal });
    return () => ac.abort();
  });
</script>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    inline-size: 100%;
    max-inline-size: none;
    block-size: var(--viewport-full);
    max-block-size: none;
    margin: 0;
    padding: var(--safe-top) 0 var(--safe-bottom);
    border: 0;
    background: var(--color-raised);
    color: var(--color-text-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu:not([open]) {
    display: none;
  }

  .menu[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: var(--header-height);
  }

  .menu__logo {
    display: inline-grid;
    place-items: center;
    min-inline-size: var(--control-height);
    min-block-size: var(--control-height);
    margin-inline-start: calc((var(--control-height) - 1.625rem) / -2);
    border-radius: var(--radius-xs);
  }

  .menu__cuerpo {
    display: grid;
    align-content: space-between;
    gap: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
    container-type: inline-size;
  }

  @media (min-width: 48rem) {
    .menu__cuerpo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-content: end;
      align-items: end;
    }
  }

  .menu__nav ul,
  .menu__contacto {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__nav ul {
    gap: var(--space-2);
    justify-items: start;
  }

  /* --text-services entero (36 → 85): el tope 7.6cqi es de la lista de servicios, no del menú.
     inline-block: el anillo de foco abraza la palabra. */
  .menu__link {
    display: inline-block;
    font-size: var(--text-services);
    min-block-size: var(--control-height);
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      font-stretch var(--duration-breathe) var(--spring-soft),
      color var(--duration-fast) var(--ease-out);
  }

  .menu__link[aria-current="page"],
  .menu__link:focus-visible {
    color: var(--color-text-primary);
    font-stretch: calc(var(--wdth-active) * 1%);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu__link:hover {
      color: var(--color-text-primary);
      font-stretch: calc(var(--wdth-active) * 1%);
    }
  }

  .menu__lateral {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .menu__contacto {
    gap: var(--space-1);
    font-size: var(--text-lead);
  }

  .menu__contacto li {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .menu__contacto li > :global(*) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .menu__toggles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
