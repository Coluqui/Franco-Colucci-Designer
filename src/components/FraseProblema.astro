---
/**
 * Frase-problema (y cierre) · PRD §3 · design system §4 y §8.
 * --text-display; ≥ 1280 hasta 10 columnas.
 * Motion v3.0 · 4.5 (efecto firma): el texto se define con el scroll, de granulado a sólido, sobre una
 * capa fantasma (data-noise-text, src/motion/textNoise.ts).
 * Sin JS, completa y visible.
 */
interface Props {
  texto: string;
  /** "p" para la frase-problema; "h2" cuando la frase es el título del bloque (cierre). */
  as?: 'p' | 'h2';
  id?: string;
}

const { texto, as: Tag = 'p', id } = Astro.props;
---

<Tag id={id} class="t-display frase" data-noise-text>{texto}</Tag>

<style>
  .frase {
    position: relative;
    margin: 0;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  /* 4.5 · capa fantasma: el mismo texto, debajo, a baja opacidad; no se selecciona dos veces. */
  .frase :global(.texto-fantasma) {
    position: absolute;
    inset: 0;
    opacity: var(--reveal-dim);
    user-select: none;
    pointer-events: none;
  }

  .frase :global(.texto-real) {
    position: relative;
  }

  @media (forced-colors: active) {
    .frase :global(.texto-fantasma) {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .frase {
      max-inline-size: calc((100% + var(--grid-gutter)) * 10 / 12 - var(--grid-gutter));
    }
  }
</style>
