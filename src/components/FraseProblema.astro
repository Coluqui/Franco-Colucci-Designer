---
/**
 * Frase-problema (y cierre) · PRD §3 · design system §4 y §8.
 * --text-display; ≥ 1280 hasta 10 columnas.
 * Motion v3.0 · 4.4: las palabras suben dentro de su máscara al entrar (data-split, src/motion/reveals.ts).
 * Reemplaza a la lectura ligada al scroll de v2.0 (M15). Pendiente (paso C): 4.5, texto que se define.
 * Sin JS, completa y visible.
 */
interface Props {
  texto: string;
  /** "p" para la frase-problema; "h2" cuando la frase es el título del bloque (cierre). */
  as?: 'p' | 'h2';
  id?: string;
}

const { texto, as: Tag = 'p', id } = Astro.props;
---

<Tag id={id} class="t-display frase" data-split>{texto}</Tag>

<style>
  .frase {
    margin: 0;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  @media (min-width: 80rem) {
    .frase {
      max-inline-size: calc((100% + var(--grid-gutter)) * 10 / 12 - var(--grid-gutter));
    }
  }
</style>
