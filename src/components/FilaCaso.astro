---
/**
 * Card de proyecto (home y Trabajos) · design system §7 y §8 · PRD v4.0 §5 (sin métricas).
 * Panel --color-surface, --radius-sm. Todo el panel es clicable (link estirado desde el título),
 * así el lector de pantalla oye un solo link con el nombre del caso.
 * - Ancho (contenedor ≥ 60rem): media 16:10 en 7 columnas + texto en 5.
 * - Angosto: una columna.
 * Hover: la media escala --scale-media-hover con --spring-soft y aparece "Ver caso →" (M27).
 * Foco: anillo en todo el panel y "Ver caso →" visible. En táctil, "Ver caso →" siempre visible.
 * Motion v3.0 (4.8): la card entra subiendo (data-reveal-item) y su media se destapa (data-reveal="clip").
 * Fase 6, paso 4: la media se convierte en el hero del caso con View Transitions (M06, M07).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icono from './Icono.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Nombre de la View Transition (M06, M07): caso-<slug>-media y caso-<slug>-titulo. */
  slug: string;
  href: string;
  titulo: string;
  /** Rol de Franco en el proyecto. */
  tipo: string;
  descripcion: string;
  /** Piezas por tipo ("Redes 7"). */
  servicios: string[];
  /** Media 16:10 (portada del proyecto). Sin imagen: marco PENDIENTE sobre --color-stage. */
  imagen?: ImageMetadata | undefined;
  alt?: string;
  /** Nivel del título según la página: h3 en la home (bajo "Trabajos"), h2 en Trabajos. */
  nivel?: 'h2' | 'h3';
  /** La primera fila de la home se ve en el primer frame: carga ansiosa. */
  prioridad?: boolean;
}

const { lang, slug, href, titulo, tipo, descripcion, servicios, imagen, alt, nivel = 'h3', prioridad = false } = Astro.props;
const Titulo = nivel;
---

<div class="fila-caja" data-fila data-reveal-item>
  <article class="fila">
    <div class="fila__media" data-reveal="clip" transition:name={`caso-${slug}-media`} transition:animate="initial">
      {
        imagen ? (
          <Image
            src={imagen}
            alt={alt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 80rem) 44rem, (min-width: 48rem) 90vw, 100vw"
            loading={prioridad ? 'eager' : 'lazy'}
            fetchpriority={prioridad ? 'high' : undefined}
          />
        ) : (
          <span class="t-label fila__pendiente">{t(lang, 'placeholder.pending')}</span>
        )
      }
    </div>

    <div class="fila__texto">
      <Titulo class="t-h3 fila__titulo"><a class="fila__link" href={href}><span class="fila__nombre" transition:name={`caso-${slug}-titulo`} transition:animate="initial">{titulo}</span></a></Titulo>
      <p class="fila__tipo">{tipo}</p>
      <p class="t-body fila__descripcion">{descripcion}</p>
      <p class="t-ui fila__servicios">
        <span class="visually-hidden">{t(lang, 'case.piecesLabel')}</span>
        {servicios.join(' · ')}
      </p>
      <span class="t-ui fila__ver" aria-hidden="true">
        {t(lang, 'case.view')}
        <Icono nombre="flecha-der" />
      </span>
    </div>
  </article>
</div>


<style>
  .fila-caja {
    container: fila / inline-size;
  }

  .fila {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  /* Angosto: el texto se aplana en la grilla y la media sube arriba. */
  .fila__texto {
    display: contents;
  }

  .fila__media {
    order: -1;
    aspect-ratio: var(--ratio-web);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-stage);
  }

  .fila__media:has(.fila__pendiente) {
    display: grid;
    place-items: center;
    color: var(--color-text-secondary);
  }

  .fila__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--spring-soft-duration) var(--spring-soft);
  }

  @container fila (min-width: 60rem) {
    .fila {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--grid-gutter);
      padding: var(--space-5);
    }

    .fila__texto {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-block: var(--space-2);
    }

    .fila__media {
      order: 0;
    }

    .fila__ver {
      margin-block-start: auto;
    }
  }

  .fila__titulo {
    margin: 0;
  }

  /* Link estirado: cubre todo el panel. */
  .fila__link {
    color: inherit;
    text-decoration: none;
  }

  .fila__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
  }

  .fila__link:focus-visible {
    outline: none;
  }

  .fila:has(.fila__link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .fila__tipo,
  .fila__servicios {
    color: var(--color-text-secondary);
  }

  /* Geist Mono es solo para metadatos de formato (design system §4). */
  .fila__tipo {
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    line-height: var(--leading-ui);
  }

  .fila__descripcion {
    max-inline-size: var(--measure);
  }

  .fila__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-weight: var(--weight-ui);
  }

  .fila:has(.fila__link:focus-visible) .fila__ver {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .fila__ver {
      opacity: 0;
      transition: opacity var(--spring-soft-duration) var(--spring-soft);
    }

    .fila:hover .fila__ver,
    .fila:has(.fila__link:focus-visible) .fila__ver {
      opacity: 1;
    }

    .fila:hover .fila__media :global(img),
    .fila:has(.fila__link:focus-visible) .fila__media :global(img) {
      transform: scale(var(--scale-media-hover));
    }
  }

  /* M27 · la flecha de "Ver caso" avanza --shift-xs con la fila (700 · soft). */
  .fila__ver :global(.icono) {
    transition: transform var(--spring-soft-duration) var(--spring-soft);
  }

  .fila:has(.fila__link:focus-visible) .fila__ver :global(.icono) {
    transform: translateX(var(--shift-xs));
  }

  @media (hover: hover) and (pointer: fine) {
    .fila:hover .fila__ver :global(.icono) {
      transform: translateX(var(--shift-xs));
    }
  }
</style>
