---
/**
 * Sobre mí (resumen) en la home · PRD §5.
 * Bio corta + link a /[lang]/sobre-mi/. Sin retrato hasta que Franco elija una foto (docs/pendientes.md).
 */
import Link from './Link.astro';
import Icono from './Icono.astro';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="resumen" data-reveal>
  <div class="resumen__texto">
    <p class="t-lead" data-split="lines">{t(lang, 'home.aboutText')}</p>
    <p class="t-ui">
      <Link href={localizePath(lang, 'sobre-mi/')} lang={lang} class="link--suelto">{t(lang, 'home.aboutLink')}<Icono nombre="flecha-der" /></Link>
    </p>
  </div>
</div>

<style>
  .resumen {
    display: grid;
    gap: var(--space-6);
  }

  .resumen__texto {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    max-inline-size: var(--measure);
  }

  .resumen__texto p {
    margin: 0;
  }
</style>
