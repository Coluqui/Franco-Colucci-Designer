---
/**
 * Íconos de interfaz: trazo de 1,5 px en currentColor, caja de 16 × 16.
 * Reemplazan a → ↗ ← ↓ ⧉ ✓ + − × porque no están en el subset de Archivo
 * y con la fuente del sistema se verían distintos en cada dispositivo.
 * Decorativos (aria-hidden): el texto accesible va en el control.
 */
export type NombreIcono =
  | 'flecha-der'
  | 'flecha-izq'
  | 'flecha-diag'
  | 'flecha-abajo'
  | 'flecha-arriba'
  | 'sol'
  | 'luna'
  | 'carrusel'
  | 'check'
  | 'mas'
  | 'cerrar'
  | 'error'
  | 'pausa'
  | 'play';

interface Props {
  nombre: NombreIcono;
  size?: string;
  class?: string;
}

const { nombre, size = 'var(--icon-size)', class: className } = Astro.props;

const trazos: Record<NombreIcono, string> = {
  'flecha-der': 'M2.5 8h11M9 3.5 13.5 8 9 12.5',
  'flecha-izq': 'M13.5 8h-11M7 3.5 2.5 8 7 12.5',
  'flecha-diag': 'M4 12 12 4M5.5 4H12v6.5',
  'flecha-abajo': 'M8 2.5v11M3.5 9 8 13.5 12.5 9',
  'flecha-arriba': 'M8 13.5v-11M3.5 7 8 2.5 12.5 7',
  sol: 'M8 5.25a2.75 2.75 0 1 1 0 5.5 2.75 2.75 0 0 1 0-5.5zM8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06',
  luna: 'M13.5 9.75A5.75 5.75 0 1 1 6.25 2.5a4.5 4.5 0 0 0 7.25 7.25z',
  carrusel: 'M5.5 2.5h8v8M2.5 5.5h8v8h-8z',
  check: 'M2.5 8.5 6 12l7.5-8',
  mas: 'M2.5 8h11M8 2.5v11',
  cerrar: 'M3.5 3.5l9 9M12.5 3.5l-9 9',
  error: 'M8 1.75 14.75 14H1.25zM8 6.5v3.5M8 11.75v.5',
  pausa: 'M5.5 3v10M10.5 3v10',
  play: 'M4.5 2.75 12.5 8l-8 5.25z',
};
---

<svg
  class:list={['icono', className]}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  style={`inline-size: ${size}; block-size: ${size}`}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
  data-icono={nombre}
>
  {
    nombre === 'mas' ? (
      <>
        <path d="M2.5 8h11" />
        <path class="icono__vertical" d="M8 2.5v11" />
      </>
    ) : (
      <path d={trazos[nombre]} />
    )
  }
</svg>

<style>
  .icono {
    display: inline-block;
    flex: none;
    vertical-align: -0.125em;
  }

  /* La barra vertical del + se puede esconder para mostrar − (FAQ, servicios en mobile). */
  .icono__vertical {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
