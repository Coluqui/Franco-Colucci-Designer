---
/**
 * Métricas grandes del caso · PRD §5 · design system §4 (rol metric) y §8 (2 × 2 en mobile).
 * Número en --text-metric con tabular-nums + etiqueta. Sin métricas reales no se renderiza
 * (nunca se inventan: PRD §8).
 */
interface Props {
  metricas: Array<{ valor: string; etiqueta: string }>;
  etiqueta: string;
}

const { metricas, etiqueta } = Astro.props;
---

{
  metricas.length > 0 && (
    <section aria-label={etiqueta}>
    <dl class="metricas">
      {metricas.map((m) => (
        <div class="metricas__item">
          <dt class="metricas__etiqueta">{m.etiqueta}</dt>
          <dd class="t-metric metricas__valor">{m.valor}</dd>
        </div>
      ))}
    </dl>
    </section>
  )
}

<style>
  .metricas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--grid-gutter);
    margin: 0;
  }

  .metricas__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-hairline);
  }

  .metricas__valor {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .metricas__etiqueta {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  @media (min-width: 80rem) {
    .metricas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
