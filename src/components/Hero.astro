---
/**
 * Hero de la home · PRD v4.0 §5 · design system §2, §4 y §8.
 * Wordmark "FRANCO / COLUCCI" a todo el ancho (H1 real: "Franco Colucci") + bajada. Sin piezas:
 * Franco prefiere que el trabajo aparezca al scrollear (24 nov).
 * Ocupa la primera pantalla desde 48rem; en angosto, 60 % del alto (Franco, 25 nov: en el celular el
 * nombre quedaba abajo con media pantalla vacía arriba). El resto se descubre al bajar (motion v3.0).
 * Motion: 4.2 (entra "FC" y se despliega en "FRANCO / COLUCCI", como el logo del header; Franco, 24 nov)
 * y 4.3 (al scrollear se achica y se va). Sin JS o con movimiento reducido: el nombre completo.
 * Hooks: data-hero, data-hero-linea, data-hero-resto, data-hero-bajada (src/motion/hero.ts).
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero" data-hero>
  <div class="container hero__caja">
    <h1 class="hero__titulo">
      <span class="visually-hidden">Franco Colucci</span>
      <span class="t-wordmark hero__wordmark" aria-hidden="true" data-hero-wordmark>
        <span class="hero__mascara"><span class="hero__linea" data-hero-linea>F<span class="hero__resto" data-hero-resto>ranco</span></span></span>
        <span class="hero__mascara"><span class="hero__linea" data-hero-linea>C<span class="hero__resto" data-hero-resto>olucci</span></span></span>
      </span>
    </h1>
    <div class="hero__bajada" data-hero-bajada>
      <p class="t-h3 hero__puesto">{t(lang, 'nav.role')}</p>
      <p class="t-lead hero__frase">{t(lang, 'hero.tagline')}</p>
    </div>
  </div>
</section>

<style>
  /* Primera pantalla completa (menos el header sticky): el trabajo se descubre recién al bajar. */
  .hero {
    display: grid;
    align-items: end;
    min-block-size: calc(100dvh - var(--header-height, 0px));
    padding-block: var(--space-6) var(--space-section);
  }

  @media (max-width: 47.999rem) {
    .hero {
      min-block-size: 60svh;
    }
  }

  /* El wordmark se mide contra este contenedor (t-wordmark usa cqi). */
  .hero__caja {
    container-type: inline-size;
    display: grid;
    /* La columna no crece con el wordmark (sin espacios entre letras propios del usuario, 1.4.12): la bajada siempre entra. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .hero__titulo {
    margin: 0;
    font: inherit;
  }

  .hero__wordmark {
    display: grid;
    color: var(--color-text-primary);
    transform-origin: left bottom;
  }

  /* Máscara de cada línea (4.2): las letras suben desde abajo sin verse fuera de la línea. */
  .hero__mascara {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.08em;
  }

  .hero__linea {
    display: block;
    white-space: nowrap;
  }

  /* Con motion, arranca plegado en "FC" (sin parpadeo): hero.ts abre el ancho de lo que falta. */
  :global(html.motion) .hero__resto {
    display: inline-block;
    inline-size: 0;
    overflow: clip;
    vertical-align: bottom;
  }

  /* Puesto (Franco, 24 nov: "Diseñador digital y UX-UI") + bajada. */
  .hero__bajada {
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
  }

  .hero__puesto,
  .hero__frase {
    margin: 0;
    text-wrap: balance;
  }

  .hero__frase {
    color: var(--color-text-secondary);
  }
</style>
