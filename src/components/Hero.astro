---
/**
 * Hero de la home · PRD v4.0 §5 · design system §2, §4 y §8.
 * Wordmark "FRANC▣ / COLUCCI" a todo el ancho (H1 real: "Franco Colucci") + bajada. Sin piezas:
 * Franco prefiere que el trabajo aparezca al scrollear (24 nov).
 * Ocupa la primera pantalla; el resto de la home se descubre al bajar (motion v3.0).
 * Motion: 4.2 (el wordmark se arma por letras en su máscara) y 4.3 (al scrollear se achica y se va).
 * Hooks: data-hero, data-hero-linea, data-hero-bajada (src/motion/hero.ts).
 */
import Glifo from './Glifo.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero" data-hero>
  <div class="container hero__caja">
    <h1 class="hero__titulo">
      <span class="visually-hidden">Franco Colucci</span>
      <span class="t-wordmark hero__wordmark" aria-hidden="true" data-hero-wordmark>
        <span class="hero__mascara"><span class="hero__linea" data-hero-linea>Franc<Glifo class="hero__glifo" /></span></span>
        <span class="hero__mascara"><span class="hero__linea" data-hero-linea>Colucci</span></span>
      </span>
    </h1>
    <p class="t-lead hero__bajada" data-hero-bajada>{t(lang, 'hero.tagline')}</p>
  </div>
</section>

<style>
  /* Primera pantalla completa (menos el header sticky): el trabajo se descubre recién al bajar. */
  .hero {
    display: grid;
    align-items: end;
    min-block-size: calc(100dvh - var(--header-height, 0px));
    padding-block: var(--space-6) var(--space-section);
  }

  /* El wordmark se mide contra este contenedor (t-wordmark usa cqi). */
  .hero__caja {
    container-type: inline-size;
    display: grid;
    /* La columna no crece con el wordmark (sin espacios entre letras propios del usuario, 1.4.12): la bajada siempre entra. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .hero__titulo {
    margin: 0;
    font: inherit;
  }

  .hero__wordmark {
    display: grid;
    color: var(--color-text-primary);
    transform-origin: left bottom;
  }

  /* Máscara de cada línea (4.2): las letras suben desde abajo sin verse fuera de la línea. */
  .hero__mascara {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.08em;
  }

  .hero__linea {
    display: block;
    white-space: nowrap;
  }

  /* El glifo ocupa el lugar de la O: alto de mayúscula (0,72 em), apoyado en la línea de base. */
  .hero__wordmark :global(.hero__glifo) {
    margin-inline-start: 0.04em;
    vertical-align: baseline;
  }

  .hero__bajada {
    max-inline-size: var(--measure);
    margin: 0;
    color: var(--color-text-secondary);
    text-wrap: balance;
  }
</style>
