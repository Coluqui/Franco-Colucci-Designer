---
/**
 * Footer · design system §7 · PRD §3.
 * Monograma "FC" grande, mail, LinkedIn, WhatsApp, CV y la firma "Franco Colucci, 2026".
 * Idioma y modo viven en el header (24 nov).
 * Motion 4.13: el footer se descubre al llegar al final y el "FC" entra letra por letra (src/motion/footer.ts).
 * Los datos de contacto salen de src/config/site.ts (PENDIENTE hasta que Franco los complete).
 */
import Glifo from './Glifo.astro';
import Link from './Link.astro';
import { t, tf, localizePath, type Lang } from '../i18n';
import { site, mailHref, linkedinHref, whatsappHref, cvHref } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const actual = Astro.url.pathname;

/** Navegación principal también acá: sin JS el menú no se abre y este es el camino entre páginas. */
const paginas = [
  { texto: t(lang, 'nav.home'), href: localizePath(lang) },
  { texto: t(lang, 'nav.work'), href: localizePath(lang, 'trabajos/') },
  { texto: t(lang, 'nav.about'), href: localizePath(lang, 'sobre-mi/') },
];
---

<footer class="footer" data-footer>
  <div class="footer__interior container" data-footer-interior>
    <div class="footer__glifo" data-footer-nombre>
      <Glifo size="100cqi" />
    </div>

    <div class="footer__datos">
      <nav aria-label={t(lang, 'nav.label')}>
        <ul class="footer__contacto" role="list">
          {
            paginas.map((p) => (
              <li>
                <a class="link link--suelto" href={p.href} aria-current={actual === p.href ? 'page' : undefined}>
                  {p.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="footer__contacto" role="list" aria-label={t(lang, 'nav.contact')}>
        <li><Link href={mailHref()} lang={lang}>{site.mail ?? t(lang, 'contact.email')}</Link></li>
        <li><Link href={linkedinHref()} lang={lang} externo>{t(lang, 'contact.linkedin')}</Link></li>
        <li><Link href={whatsappHref()} lang={lang} externo>{t(lang, 'contact.whatsapp')}</Link></li>
        <li><Link href={cvHref(lang)} lang={lang} download>{t(lang, 'contact.downloadCv')}</Link></li>
      </ul>

      <p class="t-label footer__firma">{tf(lang, 'footer.signature', { nombre: site.nombre, anio: site.anio })}</p>
    </div>
  </div>
</footer>

<style>
  /* 4.13: el footer recorta a su interior mientras se destapa. */
  .footer {
    padding-block: var(--space-section) var(--space-7);
    border-block-start: var(--border-hairline);
    overflow: clip;
  }

  .footer__interior {
    display: grid;
    gap: var(--space-8);
  }

  /* El monograma mide el ancho de esta caja (100cqi). */
  .footer__glifo {
    container-type: inline-size;
    inline-size: min(100%, 12rem);
  }

  .footer__datos {
    display: grid;
    gap: var(--space-6);
    align-content: end;
  }

  .footer__contacto {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-lead);
  }

  .footer__contacto li {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .footer__contacto li > :global(*) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .footer__firma {
    color: var(--color-text-secondary);
  }

  @media (min-width: 48rem) {
    .footer__interior {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }

    .footer__glifo {
      inline-size: min(100%, 20rem);
    }
  }
</style>
