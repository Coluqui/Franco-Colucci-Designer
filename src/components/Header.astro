---
/**
 * Header · design system §7 y §8.
 * Monograma "FC" (inicio) a la izquierda: al scrollear se despliega en "Franco Colucci" + puesto
 * (Franco, 24 nov; motion en src/motion/logo.ts; desde 48rem). A la derecha: idioma ES / EN, switch de
 * modo, "Hablemos" (primario) y "Menú" (secundario).
 * - Transparente arriba; con scroll > 8 px, --color-bg + filete (data-scrolled). M19: el fondo es una
 *   capa (::before) que aparece con opacidad (300 · in-out), así no se anima ningún color.
 * - Sobre una sección invertida, reasigna los tokens (data-invertido).
 * - 360 px: "Hablemos" pasa a la barra inferior. 1280 px o más: alto 80 px (token).
 * - "Hablemos" es un link a /[lang]/hablemos/ (funciona sin JS); con JS abre el panel.
 */
import Boton from './Boton.astro';
import Toggle from './Toggle.astro';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header class="header" data-header transition:persist={`header-${lang}`}>
  <div class="header__interior container">
    <a class="header__logo logo" href={localizePath(lang)} aria-label={t(lang, 'nav.homeLink')} data-logo>
      <span class="logo__nombre" aria-hidden="true" data-logo-nombre>
        <span>F</span><span class="logo__resto" data-logo-resto>ranco&nbsp;</span><span>C</span><span class="logo__resto" data-logo-resto>olucci</span>
        <span class="logo__puesto" data-logo-puesto>{t(lang, 'nav.role')}</span>
      </span>
    </a>

    <div class="header__acciones">
      <Toggle lang={lang} tipo="idioma" compacto />
      <Toggle lang={lang} tipo="modo" compacto />
      <Boton
        class="header__hablemos"
        size="sm"
        href={localizePath(lang, 'hablemos/')}
        data-abre-panel
      >
        {t(lang, 'nav.talk')}
      </Boton>
      <Boton
        class="header__menu"
        variante="secundario"
        size="sm"
        data-abre-menu
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
      >
        {t(lang, 'nav.menu')}
      </Boton>
    </div>
  </div>
</header>

<script>
  import { enCadaPagina } from '../scripts/pagina';

  /** data-scrolled (scroll > 8 px) y data-invertido (la franja del header está sobre una sección invertida). */
  const actualizar = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    header.toggleAttribute('data-scrolled', scrollY > 8);
    const y = header.offsetHeight / 2;
    const sobreInvertida = [...document.querySelectorAll('.seccion-invertida')].some((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= y && r.bottom >= y;
    });
    header.toggleAttribute('data-invertido', sobreInvertida);
  };

  // El header persiste entre páginas (transition:persist): se pone al día apenas cambia el contenido,
  // antes de que la View Transition tome la vista nueva.
  document.addEventListener('astro:after-swap', actualizar);

  enCadaPagina(() => {
    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        actualizar();
      });
    };
    addEventListener('scroll', alScroll, { passive: true });
    actualizar();
    return () => removeEventListener('scroll', alScroll);
  });
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    padding-block-start: var(--safe-top);
    border-block-end: 1px solid transparent;
    color: var(--color-text-primary);
  }

  /* M19 · fondo y filete en una capa propia: aparecen con opacidad. Sobre una sección invertida,
     data-invertido reasigna los tokens (la capa toma el fondo invertido). */
  .header::before {
    content: "";
    position: absolute;
    inset: 0 0 -1px;
    z-index: -1;
    border-block-end: var(--border-hairline);
    background: var(--color-bg);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-in-out);
    pointer-events: none;
  }

  .header[data-scrolled]::before {
    opacity: 1;
  }

  .header__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--header-height);
  }

  /* Logo: "FC" plegado; las letras que faltan (data-logo-resto) tienen ancho 0 hasta que el motion las abre.
     El puesto cuelga debajo del nombre (absoluto): no mueve el header. */
  .logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-xs);
  }

  .logo__nombre {
    position: relative;
    font-size: var(--text-h3);
    font-weight: var(--weight-black);
    font-stretch: calc(var(--wdth-wide) * 1%);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logo__resto {
    display: inline-block;
    inline-size: 0;
    overflow: clip;
    vertical-align: bottom;
  }

  .logo__puesto {
    position: absolute;
    inset-block-start: calc(100% + var(--space-1));
    inset-inline-start: 0;
    font-size: var(--text-small);
    font-stretch: calc(var(--wdth-normal) * 1%);
    letter-spacing: 0;
    font-weight: var(--weight-ui);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-text-secondary);
    opacity: 0;
  }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 48rem) {
    .header__acciones {
      gap: var(--space-3);
    }
  }

  /* 360 px: "Hablemos" vive en la barra inferior (design system §8). */
  /* Sin JS el botón no abre nada: la navegación está en el footer. */
  @media (scripting: none) {
    .header :global(.header__menu) {
      display: none;
    }
  }

  .header :global(.header__hablemos) {
    display: none;
  }

  @media (min-width: 48rem) {
    .header :global(.header__hablemos) {
      display: inline-flex;
    }
  }
</style>
