---
/**
 * Header · design system §7 y §8.
 * Monograma "FC" (inicio) a la izquierda: al scrollear se despliega en "Franco Colucci" + puesto
 * (Franco, 24 nov; motion en src/motion/logo.ts; desde 48rem). A la derecha: idioma ES / EN, switch de
 * modo, "Hablemos" (primario) y el menú como ícono (burger). Todos los controles a la misma altura.
 * - Transparente arriba; con scroll > 8 px, --color-bg + filete (data-scrolled). M19: el fondo es una
 *   capa (::before) que aparece con opacidad (300 · in-out), así no se anima ningún color.
 * - Sobre una sección invertida, reasigna los tokens (data-invertido).
 * - 360 px: "Hablemos" pasa a la barra inferior. 1280 px o más: alto 80 px (token).
 * - "Hablemos" es un link a /[lang]/hablemos/ (funciona sin JS); con JS abre el panel.
 */
import Boton from './Boton.astro';
import Toggle from './Toggle.astro';
import Icono from './Icono.astro';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header class="header" data-header transition:persist={`header-${lang}`}>
  <div class="header__interior container">
    <a class="header__logo logo" href={localizePath(lang)} aria-label={t(lang, 'nav.homeLink')} data-logo>
      <span class="logo__nombre" aria-hidden="true" data-logo-nombre>
        <span>F</span><span class="logo__resto" data-logo-resto>ranco&nbsp;</span><span>C</span><span class="logo__resto" data-logo-resto>olucci</span>
        <span class="logo__puesto" data-logo-puesto>{t(lang, 'nav.role')}</span>
      </span>
    </a>

    <div class="header__acciones">
      <Toggle lang={lang} tipo="idioma" compacto />
      <Toggle lang={lang} tipo="modo" compacto />
      <Boton
        class="header__hablemos"
        size="sm"
        href={localizePath(lang, 'hablemos/')}
        data-abre-panel
      >
        {t(lang, 'nav.talk')}
      </Boton>
      <button
        class="header__icono header__menu"
        type="button"
        data-abre-menu
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
        aria-label={t(lang, 'nav.menu')}
      >
        <Icono nombre="menu" />
      </button>
    </div>
  </div>
</header>

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { ScrollTrigger } from '../motion/gsap';

  /** Las secciones invertidas se buscan una vez por página, no en cada cuadro del scroll. */
  let invertidas: Element[] = [];
  const buscarInvertidas = () => (invertidas = [...document.querySelectorAll('.seccion-invertida')]);

  /** data-scrolled (scroll > 8 px) y data-invertido (la franja del header está sobre una sección invertida). */
  const actualizar = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    header.toggleAttribute('data-scrolled', scrollY > 8);
    const y = header.offsetHeight / 2;
    const sobreInvertida = invertidas.some((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= y && r.bottom >= y;
    });
    header.toggleAttribute('data-invertido', sobreInvertida);
  };

  // El header persiste entre páginas (transition:persist): se pone al día apenas cambia el contenido,
  // antes de que la View Transition tome la vista nueva.
  document.addEventListener('astro:after-swap', () => {
    buscarInvertidas();
    actualizar();
  });

  // Con ScrollSmoother el contenido sigue moviéndose después del último evento `scroll`: ScrollTrigger
  // se actualiza con el desplazamiento suavizado, así el color del header sigue a lo que se ve.
  enCadaPagina(() => {
    buscarInvertidas();
    const seguimiento = ScrollTrigger.create({ start: 0, end: 'max', onUpdate: actualizar, onRefresh: actualizar });
    actualizar();
    return () => seguimiento.kill();
  });
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    padding-block-start: var(--safe-top);
    border-block-end: 1px solid transparent;
    color: var(--color-text-primary);
  }

  /* M19 · fondo y filete en una capa propia: aparecen con opacidad. Sobre una sección invertida,
     data-invertido reasigna los tokens (la capa toma el fondo invertido). */
  .header::before {
    content: "";
    position: absolute;
    inset: 0 0 -1px;
    z-index: -1;
    border-block-end: var(--border-hairline);
    background: var(--color-bg);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-in-out);
    pointer-events: none;
  }

  .header[data-scrolled]::before {
    opacity: 1;
  }

  .header__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--header-height);
  }

  /* Logo: "FC" plegado; las letras que faltan (data-logo-resto) tienen ancho 0 hasta que el motion las abre.
     El puesto cuelga debajo del nombre (absoluto): no mueve el header. */
  .logo {
    display: inline-flex;
    min-inline-size: var(--control-height);
    align-items: center;
    min-block-size: var(--control-height);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-xs);
  }

  .logo__nombre {
    position: relative;
    font-size: var(--text-h3);
    font-weight: var(--weight-black);
    font-stretch: calc(var(--wdth-wide) * 1%);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logo__resto {
    display: inline-block;
    inline-size: 0;
    overflow: clip;
    vertical-align: bottom;
  }

  .logo__puesto {
    position: absolute;
    inset-block-start: calc(100% + var(--space-1));
    inset-inline-start: 0;
    font-size: var(--text-small);
    font-stretch: calc(var(--wdth-normal) * 1%);
    letter-spacing: 0;
    font-weight: var(--weight-ui);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-text-secondary);
    opacity: 0;
  }

  .header__acciones {
    --alto-control: var(--control-height);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Misma altura para todo: 44 en táctil/angosto; 36 desde 48rem, como el botón "Hablemos" (sm). */
  @media (min-width: 48rem) {
    .header__acciones {
      --alto-control: var(--control-height-sm);
      gap: var(--space-3);
    }
  }

  .header__acciones :global(.segmentado) {
    padding: 0;
  }

  /* Controles de 36 px desde 48rem: área táctil de 44 px por arriba y por abajo (design system §7). */
  .header__acciones :global(.segmentado__opcion),
  .header__acciones :global(.tema-switch),
  .header__icono {
    position: relative;
  }

  .header__acciones :global(.segmentado__opcion)::before,
  .header__acciones :global(.tema-switch)::before,
  .header__icono::before {
    content: "";
    position: absolute;
    inset-block: min(0px, calc((100% - var(--control-height)) / 2));
    inset-inline: min(0px, calc((100% - var(--control-height)) / 2));
  }

  /* ES y EN están pegados: cada opción mide 44 de ancho (no pueden crecer hacia el costado). */
  .header__acciones :global(.segmentado__opcion) {
    min-block-size: calc(var(--alto-control) - 2px);
    min-inline-size: var(--control-height);
  }

  .header__acciones :global(.tema-switch),
  .header__icono {
    inline-size: var(--alto-control);
    block-size: var(--alto-control);
  }

  .header__icono {
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: var(--border-control);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .header__icono:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__icono:hover {
      background: var(--color-surface);
    }
  }

  /* 360 px: "Hablemos" vive en la barra inferior (design system §8). */
  /* Sin JS el botón no abre nada: la navegación está en el footer. */
  @media (scripting: none) {
    .header :global(.header__menu) {
      display: none;
    }
  }

  .header :global(.header__hablemos) {
    display: none;
  }

  @media (min-width: 48rem) {
    .header :global(.header__hablemos) {
      display: inline-flex;
    }
  }
</style>
