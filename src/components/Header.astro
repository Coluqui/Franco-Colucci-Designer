---
/**
 * Header · design system §7 y §8.
 * Glifo (inicio) a la izquierda; "▣ Hablemos" (primario) + "Menú" (secundario) a la derecha.
 * - Transparente arriba; con scroll > 8 px, --color-bg + filete (data-scrolled). M19 anima esto en la Fase 6.
 * - Sobre una sección invertida, reasigna los tokens (data-invertido).
 * - 360 px: "Hablemos" pasa a la barra inferior. 1280 px o más: alto 80 px (token).
 * - "Hablemos" es un link a /[lang]/hablemos/ (funciona sin JS); con JS abre el panel.
 */
import Boton from './Boton.astro';
import Glifo from './Glifo.astro';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header class="header" data-header>
  <div class="header__interior container">
    <a class="header__logo" href={localizePath(lang)} aria-label={t(lang, 'nav.homeLink')}>
      <Glifo size="1.625rem" />
    </a>

    <div class="header__acciones">
      <Boton
        class="header__hablemos"
        size="sm"
        glifo
        href={localizePath(lang, 'hablemos/')}
        data-abre-panel
        aria-haspopup="dialog"
      >
        {t(lang, 'nav.talk')}
      </Boton>
      <Boton
        variante="secundario"
        size="sm"
        data-abre-menu
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
      >
        {t(lang, 'nav.menu')}
      </Boton>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      header.toggleAttribute('data-scrolled', scrollY > 8);
      // ¿La franja del header está sobre una sección invertida?
      const y = header.offsetHeight / 2;
      const sobreInvertida = [...document.querySelectorAll('.seccion-invertida')].some((s) => {
        const r = s.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
      header.toggleAttribute('data-invertido', sobreInvertida);
    };
    addEventListener(
      'scroll',
      () => {
        if (!pendiente) {
          pendiente = true;
          requestAnimationFrame(actualizar);
        }
      },
      { passive: true },
    );
    actualizar();
  }
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    padding-block-start: var(--safe-top);
    border-block-end: 1px solid transparent;
    color: var(--color-text-primary);
  }

  .header[data-scrolled] {
    background: var(--color-bg);
    border-block-end: var(--border-hairline);
  }

  .header__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--header-height);
  }

  .header__logo {
    display: inline-grid;
    place-items: center;
    min-inline-size: var(--control-height);
    min-block-size: var(--control-height);
    margin-inline-start: calc((var(--control-height) - 1.625rem) / -2);
    color: var(--color-text-primary);
    border-radius: var(--radius-xs);
  }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* 360 px: "Hablemos" vive en la barra inferior (design system §8). */
  .header :global(.header__hablemos) {
    display: none;
  }

  @media (min-width: 48rem) {
    .header :global(.header__hablemos) {
      display: inline-flex;
    }
  }
</style>
