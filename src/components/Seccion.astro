---
/**
 * Sección de página · design system §6 y §8.
 * Separación vertical --space-section; título h2 opcional (con slot "accion" a la derecha);
 * `invertida` aplica el remapeo de tokens de .seccion-invertida (clientes, cierre, siguiente caso).
 * M16: cuando el título entra un 15 %, una vez, el H2 y el primer bloque suben y aparecen. Una entrada
 * por sección; nunca piezas, y si el bloque son filas de caso, las filas entran solas (M17).
 */
interface Props {
  id?: string;
  titulo?: string;
  /** Título solo para lectores de pantalla (cuando el diseño no lo muestra). */
  tituloOculto?: boolean;
  invertida?: boolean;
  class?: string;
}

const { id, titulo, tituloOculto = false, invertida = false, class: className } = Astro.props;
const idTitulo = id && titulo ? `${id}-titulo` : undefined;
---

<section
  id={id}
  data-seccion
  class:list={['seccion', { 'seccion-invertida': invertida }, className]}
  aria-labelledby={idTitulo}
>
  <div class="container seccion__caja">
    {
      titulo && (
        <div class="seccion__cabecera">
          <h2 id={idTitulo} class:list={{ 'visually-hidden': tituloOculto }}>
            {titulo}
          </h2>
          {Astro.slots.has('accion') && <slot name="accion" />}
        </div>
      )
    }
    <slot />
  </div>
</section>

<script>
  import { ms } from '../scripts/motion/base';
  import { entrar, type Parte } from '../scripts/motion/observer';
  import { enCadaPagina } from '../scripts/pagina';

  enCadaPagina(() => {
    document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((seccion) => {
      const caja = seccion.querySelector<HTMLElement>('.seccion__caja');
      const cabecera = caja?.querySelector<HTMLElement>(':scope > .seccion__cabecera');
      const titulo = cabecera?.querySelector('h2:not(.visually-hidden)') ? cabecera : null;
      const bloque = (cabecera ? cabecera.nextElementSibling : caja?.firstElementChild) as HTMLElement | null;
      // Ni piezas (tiles, vista previa de servicios) ni filas (las filas tienen su propia entrada, M17).
      const bloqueSirve = bloque && !bloque.querySelector('[data-fila], .tile, [data-servicios]');
      const partes: Parte[] = [];
      if (titulo) partes.push({ el: titulo });
      if (bloqueSirve) partes.push({ el: bloque, retraso: titulo ? ms('--stagger') : 0 });
      const disparador = titulo ?? (bloqueSirve ? bloque : null);
      if (disparador) entrar(disparador, partes);
    });
  });
</script>

<style>
  .seccion {
    padding-block: var(--space-section);
  }

  /* Dos secciones de fondo igual seguidas no duplican el espacio. */
  .seccion:not(.seccion-invertida) + .seccion:not(.seccion-invertida) {
    padding-block-start: 0;
  }

  .seccion__caja {
    display: grid;
    gap: var(--space-8);
  }

  .seccion__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .seccion__cabecera h2 {
    margin: 0;
    text-wrap: balance;
  }
</style>
