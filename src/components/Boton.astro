---
/**
 * Botón · design system §7 (primario y secundario).
 * - Con `href` es un <a>; sin `href`, un <button>.
 * - Alto visual 36 px (--control-height-sm) en `size="sm"` (header) con área táctil de 44 px; 44 px por defecto.
 * - Primario: tinta → cobalto en hover (M25: el desencastre del glifo llega en la Fase 6).
 * - Press: scale(--scale-press) y vuelve con --spring-press.
 * - Loading: texto de carga + barra en la base (M32). Usa aria-disabled y no disabled, para que el
 *   foco no se pierda al enviar. Con `textoCarga`, la barra ya está en el DOM y la muestra aria-busy
 *   (así el formulario la prende desde JS).
 * - href null (dato pendiente): <span> con "(pendiente)" para lectores de pantalla.
 */
import type { HTMLAttributes } from 'astro/types';
import Glifo from './Glifo.astro';
import Icono, { type NombreIcono } from './Icono.astro';
import { t, langFromUrl } from '../i18n';

type Props = {
  variante?: 'primario' | 'secundario';
  size?: 'md' | 'sm';
  href?: string | null;
  glifo?: boolean;
  icono?: NombreIcono;
  disabled?: boolean;
  loading?: boolean;
  /** Texto que reemplaza al label mientras carga ("Enviando"). */
  textoCarga?: string;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'disabled'> &
  Omit<HTMLAttributes<'a'>, 'href'>;

const {
  variante = 'primario',
  size = 'md',
  href,
  glifo = false,
  icono,
  disabled = false,
  loading = false,
  textoCarga,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const lang = langFromUrl(Astro.url);
const pendiente = href === null;
const clases = ['boton', `boton--${variante}`, `boton--${size}`, className];
---

{
  pendiente ? (
    /* Dato pendiente: no es un link (un <a> sin href no anuncia aria-disabled). Igual que Link. */
    <span class:list={[...clases, 'boton--pendiente']}>
      {glifo && <Glifo size="0.875rem" class="boton__glifo" />}
      <span class="boton__texto"><slot /></span>
      {icono && <Icono nombre={icono} class="boton__icono" />}
      <span class="visually-hidden">{t(lang, 'a11y.pending')}</span>
    </span>
  ) : href !== undefined ? (
    <a
      class:list={clases}
      href={disabled || loading ? undefined : href}
      role={disabled || loading ? 'link' : undefined}
      aria-disabled={disabled || loading ? 'true' : undefined}
      aria-busy={loading ? 'true' : undefined}
      {...rest}
    >
      {glifo && <Glifo size="0.875rem" class="boton__glifo" />}
      <span class="boton__texto">{loading && textoCarga ? textoCarga : <slot />}</span>
      {icono && <Icono nombre={icono} class="boton__icono" />}
      {(loading || textoCarga) && <span class="boton__carga" aria-hidden="true" />}
    </a>
  ) : (
    <button
      class:list={clases}
      type={type}
      disabled={disabled}
      aria-disabled={loading ? 'true' : undefined}
      aria-busy={loading ? 'true' : undefined}
      {...rest}
    >
      {glifo && <Glifo size="0.875rem" class="boton__glifo" />}
      <span class="boton__texto">{loading && textoCarga ? textoCarga : <slot />}</span>
      {icono && <Icono nombre={icono} class="boton__icono" />}
      {(loading || textoCarga) && <span class="boton__carga" aria-hidden="true" />}
    </button>
  )
}

<script>
  import { enCadaPagina } from '../scripts/pagina';
  import { animar, curva, ms, numero, resorte, rodarTexto } from '../scripts/motion/base';

  /**
   * M31 · descargar (botones con download, p. ej. "CV" en la barra inferior): la flecha baja y cae
   * (280 · press); "CV" → "Descargando" → "CV ✓" y vuelve a los --hold-feedback.
   * Reducido: los tokens dejan solo el cambio de texto.
   */
  enCadaPagina(() => {
    const temporizadores: number[] = [];
    document.querySelectorAll<HTMLAnchorElement>('a.boton[download]').forEach((a) => {
      const texto = a.querySelector<HTMLElement>('.boton__texto');
      const flecha = a.querySelector<HTMLElement>('.boton__icono');
      const original = texto?.textContent ?? '';
      const descargando = a.dataset['textoDescargando'];
      if (!texto || !descargando) return;
      a.addEventListener('click', () => {
        if (a.dataset['estado']) return;
        a.dataset['estado'] = 'descargando';
        const cae = `translateY(${numero('--shift-sm')}px)`;
        if (flecha) animar(flecha, { opacity: '0', transform: cae }, resorte('press'));
        rodarTexto(texto, descargando);
        const paso = ms('--duration-slow');
        temporizadores.push(
          window.setTimeout(() => {
            rodarTexto(texto, original).then(() => (a.dataset['estado'] = 'ok'));
          }, paso),
          window.setTimeout(() => {
            // "CV ✓" sale rodando y entra "CV" (la ✓ se va con el texto, no de golpe).
            rodarTexto(texto, original, curva('out', 'fast'), -1).then(() => delete a.dataset['estado']);
            if (flecha) {
              flecha.style.opacity = '';
              flecha.style.transform = '';
              animar(flecha, { opacity: '1', transform: 'none' }, { ...curva('out', 'fast'), desde: { opacity: '0', transform: `translateY(${-numero('--shift-sm')}px)` }, soltar: true });
            }
          }, paso + ms('--hold-feedback')),
        );
      });
    });
    return () => temporizadores.forEach((t) => window.clearTimeout(t));
  });
</script>

<style>
  .boton {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-block-size: var(--control-height);
    padding-inline: var(--control-pad-x);
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    font-size: var(--text-ui);
    font-weight: var(--weight-ui);
    font-stretch: calc(var(--wdth-normal) * 1%);
    line-height: var(--leading-ui);
    text-decoration: none;
    /* Con texto al 200 % (WCAG 1.4.4 y 1.4.10) el label pasa a dos líneas en vez de desbordar. */
    max-inline-size: 100%;
    text-align: center;
    text-wrap: balance;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--spring-press-duration) var(--spring-press);
    -webkit-tap-highlight-color: transparent;
  }

  /* Alto visual 36 px con área táctil de 44 px (design system §7, header). */
  .boton--sm {
    min-block-size: var(--control-height-sm);
    overflow: visible;
  }

  .boton--sm::before {
    content: "";
    position: absolute;
    inset-block: calc((var(--control-height-sm) - var(--control-height)) / 2);
    inset-inline: 0;
  }

  /* ---- Primario ---- */
  .boton--primario {
    background: var(--color-text-primary);
    color: var(--color-bg);
  }

  /* ---- Secundario ---- */
  .boton--secundario {
    border: var(--border-control);
    background: transparent;
    color: var(--color-text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .boton--primario:not([aria-disabled="true"], :disabled, .boton--pendiente):hover {
      background: var(--color-accent);
      color: var(--color-on-accent);
    }

    .boton--secundario:not([aria-disabled="true"], :disabled, .boton--pendiente):hover {
      background: var(--color-surface);
    }
  }

  .boton:not([aria-disabled="true"], :disabled, .boton--pendiente):active {
    transform: scale(var(--scale-press));
  }

  /* ---- Deshabilitado ---- */
  .boton:disabled,
  .boton:is([aria-disabled="true"], .boton--pendiente) {
    cursor: not-allowed;
  }

  .boton--primario:disabled,
  .boton--primario:is([aria-disabled="true"], .boton--pendiente) {
    background: var(--color-surface);
    color: var(--color-text-disabled);
  }

  .boton--secundario:disabled,
  .boton--secundario:is([aria-disabled="true"], .boton--pendiente) {
    border-color: var(--color-text-disabled);
    color: var(--color-text-disabled);
  }

  /* ---- Cargando: el botón se ve activo (no gris) y muestra la barra en la base ---- */
  .boton[aria-busy="true"] {
    cursor: progress;
  }

  .boton--primario[aria-busy="true"] {
    background: var(--color-text-primary);
    color: var(--color-bg);
  }

  .boton__carga {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: var(--progress-height);
    background: currentColor;
    opacity: var(--progress-opacity);
    transform-origin: left;
    transform: scaleX(0.4);
  }

  /* La barra está en el DOM si el botón puede cargar; se ve solo mientras carga (aria-busy). */
  .boton:not([aria-busy="true"]) .boton__carga {
    display: none;
  }

  .boton__texto {
    display: inline-block;
  }

  /* M32 · enviando: la barra de la base recorre el botón sin parar (indeterminada). Con movimiento
     reducido queda quieta: el botón sigue diciendo "Enviando". */
  @media (prefers-reduced-motion: no-preference) {
    .boton__carga {
      animation: boton-carga calc(var(--duration-page) * 2) var(--ease-in-out) infinite;
    }
  }

  @keyframes boton-carga {
    from {
      transform: translateX(-100%) scaleX(0.4);
    }

    to {
      transform: translateX(100%) scaleX(0.4);
    }
  }

  /* M31 · "CV ✓": la marca es visual. */
  .boton[data-estado="ok"] .boton__texto::after {
    content: " ✓" / "";
  }
</style>
