---
/**
 * Lista de servicios · design system §7 y §8 · PRD §3 · motion M05 y M13.
 * Base: acordeón exclusivo nativo (<details name>): funciona sin JS y con teclado.
 * - Angosto: + / −; la descripción, la vista previa y el link van dentro del ítem abierto.
 * - Ancho (contenedor ≥ 60rem): lista en 7 columnas con ítems de alto fijo y, a la derecha
 *   (5 columnas), la vista previa fija del ítem abierto (caja --color-stage). El marco toma el
 *   formato de la pieza de ese servicio (--ratio-*). Hover con intención (--hover-intent) o foco
 *   abre el ítem; un clic no lo cierra (siempre hay uno activo).
 * Activo: --color-text-primary y wdth 125; inactivos: --color-text-secondary y wdth 112 (M13: respira).
 * M05 (encastre): con JS, el marco es el recorte (clip-path) de una capa del tamaño del escenario;
 * al cambiar de servicio el recorte pasa del formato anterior al nuevo con --spring-snap, la pieza
 * anterior se va con fundido y la nueva entra cuando el marco llegó al 70 %. Sin JS, el marco es
 * una caja de su proporción (como antes).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icono from './Icono.astro';
import { t, tf, localizePath, type Lang } from '../i18n';

/** Nombre del token --ratio-* del formato de la pieza de vista previa. */
type Ratio = 'square' | 'carousel' | 'reel' | 'mail-header' | 'web';

interface Servicio {
  slug: string;
  nombre: string;
  descripcion: string;
  ratio: Ratio;
  imagen?: ImageMetadata;
  alt?: string;
}

interface Props {
  lang: Lang;
  servicios: Servicio[];
  /** Nombre del grupo exclusivo (único por página). */
  grupo?: string;
}

const { lang, servicios, grupo = 'servicios' } = Astro.props;
---

<div class="servicios-caja">
  <ul class="servicios" role="list" data-servicios>
    {
      servicios.map((s, i) => (
        <li class="servicio" style={`--ratio: var(--ratio-${s.ratio})`}>
          <details name={grupo} open={i === 0} data-servicio>
            <summary class="servicio__nombre">
              <span class="t-services">{s.nombre}</span>
              <Icono nombre="mas" class="servicio__signo" />
            </summary>
            <div class="servicio__panel">
              <div class="servicio__escenario">
                <div class="servicio__capa" data-servicio-capa>
                  <figure class="servicio__marco" data-servicio-marco>
                    {s.imagen ? (
                      <Image src={s.imagen} alt={s.alt ?? ''} widths={[400, 720]} sizes="(min-width: 80rem) 32rem, 90vw" loading="lazy" />
                    ) : (
                      <figcaption class="t-label servicio__pendiente">{t(lang, 'services.pendingPreview')}</figcaption>
                    )}
                  </figure>
                </div>
              </div>
              <p class="t-body servicio__descripcion">{s.descripcion}</p>
              <a class="link t-ui servicio__link" href={localizePath(lang, `trabajos/?servicio=${s.slug}`)}>
                {tf(lang, 'services.seeWork', { servicio: s.nombre })}
                <Icono nombre="flecha-der" />
              </a>
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { animar, curva, detener, ms, resorte } from '../scripts/motion/base';
  import { encastrar, medida, recorte, type Medida } from '../scripts/motion/encastre';
  import { alEntrar } from '../scripts/motion/observer';

  /* Solo en el modo ancho: hover con intención o foco abren el ítem; el clic no lo cierra. */
  document.querySelectorAll<HTMLElement>('[data-servicios]').forEach((lista) => {
    const ancho = () => getComputedStyle(lista).getPropertyValue('--servicios-fijo').trim() === '1';
    const intencion = () => ms('--hover-intent');
    let espera: number | undefined;

    const capaDe = (d: HTMLDetailsElement) => d.querySelector<HTMLElement>('[data-servicio-capa]')!;
    const marcoDe = (d: HTMLDetailsElement) => d.querySelector<HTMLElement>('[data-servicio-marco]')!;
    /** Tamaño del marco de cada ítem la última vez que se vio (cerrado mide 0). */
    const marcos = new WeakMap<HTMLDetailsElement, Medida>();
    let activo: HTMLDetailsElement | null = null;

    /** Recorte fijo, sin animar: carga, acordeón angosto y cambios de tamaño. */
    const fijar = (d: HTMLDetailsElement) => {
      const capa = capaDe(d);
      const marco = medida(marcoDe(d));
      detener(capa);
      capa.style.clipPath = recorte(medida(capa), marco);
      marcos.set(d, marco);
    };

    /** M05: el marco pasa del formato del servicio anterior al del nuevo. */
    const activar = (d: HTMLDetailsElement) => {
      if (!d.open || d === activo) return;
      const anterior = activo;
      activo = d;
      if (!anterior || !ancho()) return fijar(d);

      const capa = capaDe(d);
      const caja = medida(capa);
      const nuevo = medida(marcoDe(d));
      const viejo = marcos.get(anterior) ?? nuevo;
      marcos.set(d, nuevo);
      // Si el anterior seguía encastrando, se arranca desde su forma de este instante (sin saltos).
      const capaAnterior = capaDe(anterior);
      const enCurso = capaAnterior.getAnimations().some((a) => a.playState === 'running');
      const desde = enCurso ? getComputedStyle(capaAnterior).clipPath : recorte(caja, viejo);
      detener(capaAnterior);
      detener(capa);
      encastrar(capa, recorte(caja, nuevo), { desde: { clipPath: desde } });

      // La pieza nueva entra cuando el marco llegó al 70 %.
      const pieza = marcoDe(d).firstElementChild as HTMLElement | null;
      if (pieza) {
        detener(pieza);
        animar(pieza, { opacity: 1 }, { ...curva('out', 'fast'), delay: resorte('snap').duration * 0.7, fill: 'both', desde: { opacity: 0 } });
      }

      // La anterior se va con fundido, recortada por el marco que cambia (una copia en su tamaño).
      capa.querySelector('[data-servicio-salida]')?.remove();
      const imagen = marcoDe(anterior).querySelector('img');
      if (imagen) {
        const salida = imagen.cloneNode() as HTMLImageElement;
        salida.removeAttribute('loading');
        salida.alt = '';
        salida.dataset['servicioSalida'] = '';
        salida.className = 'servicio__salida';
        Object.assign(salida.style, { inlineSize: `${viejo.w}px`, blockSize: `${viejo.h}px` });
        capa.append(salida);
        // Fundido cruzado: la vieja se ve recortada todo el recorrido y se cruza con la nueva al 70 %.
        animar(salida, { opacity: 0 }, { ...curva('in', 'fast'), delay: resorte('snap').duration * 0.7 }).finished.then(
          () => salida.remove(),
          () => salida.remove(),
        );
      }
    };

    lista.querySelectorAll<HTMLDetailsElement>('[data-servicio]').forEach((d) => {
      const summary = d.querySelector('summary');
      if (!summary) return;
      // El clic nativo cambia el estado después: el encastre sale del evento toggle.
      d.addEventListener('toggle', () => activar(d));
      summary.addEventListener('click', (e) => {
        if (ancho() && d.open) e.preventDefault();
      });
      summary.addEventListener('focus', () => {
        if (!ancho()) return;
        d.open = true;
        activar(d);
      });
      summary.addEventListener('pointerenter', (e) => {
        if (!ancho() || e.pointerType !== 'mouse') return;
        window.clearTimeout(espera);
        espera = window.setTimeout(() => {
          // El mouse no le saca el panel al teclado: si el foco está dentro del abierto, no cambia.
          const foco = document.activeElement;
          if (activo && activo !== d && activo.contains(foco) && foco !== activo.querySelector('summary')) return;
          d.open = true;
          activar(d);
        }, intencion());
      });
      summary.addEventListener('pointerleave', () => window.clearTimeout(espera));
    });

    // Con JS, el marco pasa a ser el recorte de la capa.
    activo = lista.querySelector<HTMLDetailsElement>('[data-servicio][open]');
    if (activo) fijar(activo);
    lista.dataset['encastre'] = '';
    // Las piezas de los ítems cerrados se piden al llegar a la lista: el fundido no espera la red.
    alEntrar(lista, () => lista.querySelectorAll('img').forEach((i) => (i.loading = 'eager')));
    new ResizeObserver(() => {
      if (activo?.open) fijar(activo);
    }).observe(lista);
  });
</script>

<style>
  .servicios-caja {
    container: servicios / inline-size;
  }

  .servicios {
    --servicios-fijo: 0;
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .servicio {
    border-block-end: var(--border-hairline);
  }

  .servicio__nombre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--control-height);
    padding-block: var(--space-2);
    color: var(--color-text-secondary);
    font-stretch: calc(var(--wdth-rest) * 1%);
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
    container-type: inline-size;
    /* M13 · respiración: el activo pasa de 112 a 125 y el que deja de estarlo vuelve (⚠ font-stretch:
       una sola línea, alto fijo, no mueve nada alrededor). Reducido: todos en 125, solo cambia el color. */
    transition:
      font-stretch var(--duration-breathe) var(--spring-soft),
      color var(--duration-fast) var(--ease-out);
  }

  .servicio__nombre::-webkit-details-marker {
    display: none;
  }

  .servicio__nombre .t-services {
    font-stretch: inherit;
  }

  details[open] > .servicio__nombre {
    color: var(--color-text-primary);
    font-stretch: calc(var(--wdth-active) * 1%);
  }

  /* Solo en acordeón: en ancho el color lo decide el ítem abierto (después de --hover-intent). */
  @media (hover: hover) and (pointer: fine) {
    @container servicios (max-width: 59.999rem) {
      .servicio__nombre:hover {
        color: var(--color-text-primary);
      }
    }
  }

  /* + / −: la barra vertical desaparece al abrir. */
  .servicio__nombre :global(.servicio__signo) {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  details[open] > .servicio__nombre :global(.icono__vertical) {
    opacity: 0;
  }

  .servicio__panel {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-2) var(--space-6);
  }

  /* Escenario: caja fija; el marco adentro toma el formato de la pieza y entra entero. */
  .servicio__escenario {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio-square);
    max-inline-size: 60dvh; /* acordeón a 768 px: la caja 1:1 ocupaba toda la pantalla */
    padding: var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-stage);
    container-type: size;
  }

  /* La capa ocupa todo el escenario (tamaño fijo): con JS, su recorte es el marco. */
  .servicio__capa {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 100cqi;
    block-size: 100cqb;
  }

  .servicio__marco {
    display: grid;
    place-items: center;
    inline-size: min(100cqi, calc(100cqb * var(--ratio)));
    aspect-ratio: var(--ratio);
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-surface);
  }

  /* Hasta que el script fija el recorte, la capa no se ve (nunca un cuadro lleno de un frame). */
  /* --color-bg contrasta con --color-stage en los dos modos: el cambio de formato se lee. */
  .servicios[data-encastre] .servicio__capa {
    clip-path: inset(50%);
    background: var(--color-bg);
  }

  .servicios[data-encastre] .servicio__marco {
    background: none;
  }

  /* La pieza que se va: centrada en su tamaño, se cruza con la nueva al 70 %. */
  .servicio__capa :global(.servicio__salida) {
    position: absolute;
    inset: 0;
    margin: auto;
    object-fit: cover;
    pointer-events: none;
  }

  .servicio__marco :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .servicio__pendiente {
    padding: var(--space-3);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .servicio__descripcion {
    max-inline-size: var(--measure);
    color: var(--color-text-secondary);
  }

  .servicio__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-block-size: var(--control-height);
  }

  /* ---- Ancho: lista en 7 columnas + vista previa fija en 5 ---- */
  @container servicios (min-width: 60rem) {
    /* La lista reserva el alto del panel: escenario cuadrado de 5 col + descripción y link. */
    .servicios {
      --servicios-fijo: 1;
      min-block-size: calc((100cqi - var(--grid-gutter)) * 5 / 12 + var(--space-10) + var(--space-6));
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--grid-gutter);
    }

    .servicio {
      grid-column: 1;
    }

    .servicio__nombre :global(.servicio__signo) {
      display: none;
    }

    /* El panel del ítem abierto se ubica en la columna derecha, a lo alto de toda la lista. */
    .servicio__panel {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: 0;
      inline-size: calc((100% - var(--grid-gutter)) * 5 / 12);
      padding: 0;
    }
  }
</style>
