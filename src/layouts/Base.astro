---
/**
 * Layout base: idioma, metadatos, fuentes, tema sin parpadeo, grano y salto al contenido.
 * El header, el menú y el footer se suman en la Fase 3.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import PanelHablemos from '../components/PanelHablemos.astro';
import { t,switchLangPath, locales, defaultLang, type Lang } from '../i18n';

/** Solo se precarga Archivo (subset latin): es el LCP (wordmark) y cubre todo el español. */
const archivoLatin = '/fonts/archivo-latin.woff2';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Previews, páginas internas y 404: no se indexan. */
  noindex?: boolean;
  /** hreflang a la misma ruta en cada idioma. false en páginas que existen en un solo idioma (/es/dev/*). */
  alternates?: boolean;
  /** Header, menú, panel Hablemos, barra mobile y footer. Las páginas reales lo activan en la Fase 4. */
  chrome?: boolean;
}

const { lang, title, description, noindex = false, alternates = true, chrome = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!--
      Tema sin parpadeo: corre antes de pintar. Con una elección guardada aplica data-theme;
      sin elección, no pone nada y los tokens siguen al sistema (prefers-color-scheme).
    -->
    <script is:inline>
      try {
        var tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch (e) {}
    </script>

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    {/* Rutas relativas hasta tener dominio (`site`, Fase 8): ahí pasan a absolutas. */}
    {alternates && locales.map((l) => <link rel="alternate" hreflang={l} href={switchLangPath(Astro.url, l)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={switchLangPath(Astro.url, defaultLang)} />}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t(lang, 'a11y.skipToContent')}</a>
    {chrome && <Header lang={lang} />}
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    {chrome && <Menu lang={lang} />}
    {chrome && <PanelHablemos lang={lang} />}
  </body>
</html>
