---
/**
 * Layout base: idioma, metadatos, fuentes, tema sin parpadeo, grano y salto al contenido.
 * Con `chrome`: header, footer, barra mobile, menú y panel Hablemos.
 */
import '../styles/global.css';
import '../styles/transiciones.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import PanelHablemos from '../components/PanelHablemos.astro';
import BarraMobile from '../components/BarraMobile.astro';
import Footer from '../components/Footer.astro';
import { t, switchLangPath, locales, defaultLang, type Lang } from '../i18n';
import { site } from '../config/site';
import { indexar } from '../config/indexar';

/** Solo se precarga Archivo (subset latin): es el LCP (wordmark) y cubre todo el español. */
const archivoLatin = '/fonts/archivo-latin.woff2';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Previews, páginas internas y 404: no se indexan. */
  noindex?: boolean;
  /** hreflang a la misma ruta en cada idioma. false en páginas que existen en un solo idioma (/es/dev/*). */
  alternates?: boolean;
  /** Header, menú, panel Hablemos, barra mobile y footer. Las páginas reales lo activan en la Fase 4. */
  chrome?: boolean;
}

const { lang, title, description, noindex = false, alternates = true, chrome = false } = Astro.props;
/** URL absoluta en el dominio público (`site`), sin query: canonical, hreflang y Open Graph. */
const absoluta = (ruta: string) => new URL(ruta.split("?")[0]!, Astro.site ?? Astro.url).href;
const canonica = absoluta(Astro.url.pathname);
const ogLocale = { es: 'es_AR', en: 'en_US' } satisfies Record<Lang, string>;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !indexar) && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonica} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates && locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {site.ogImagen && <meta property="og:image" content={absoluta(site.ogImagen)} />}
    <meta name="twitter:card" content={site.ogImagen ? 'summary_large_image' : 'summary'} />

    <!--
      Tema sin parpadeo: corre antes de pintar. Con una elección guardada aplica data-theme;
      sin elección, no pone nada y los tokens siguen al sistema (prefers-color-scheme).
      data-js: hay JS (la frase de M15 arranca atenuada desde el primer cuadro, sin parpadeo).
    -->
    <script is:inline>
      (function () {
        var html = function () {
          var d = document.documentElement;
          d.dataset.js = '';
          try {
            var tema = localStorage.getItem('tema');
            if (tema === 'light' || tema === 'dark') d.dataset.theme = tema;
          } catch (e) {}
        };
        html();
        // ClientRouter copia los atributos de <html> de la página nueva: se vuelven a poner antes de pintarla.
        if (!window.__temaNav) {
          window.__temaNav = true;
          document.addEventListener('astro:after-swap', html);
        }
      })();
    </script>

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    {alternates && locales.map((l) => <link rel="alternate" hreflang={l} href={absoluta(switchLangPath(Astro.url, l))} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={absoluta(switchLangPath(Astro.url, defaultLang))} />}

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t(lang, 'a11y.skipToContent')}</a>
    {chrome && <Header lang={lang} />}
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    {chrome && <Footer lang={lang} />}
    {chrome && <BarraMobile lang={lang} />}
    {chrome && <Menu lang={lang} />}
    {chrome && <PanelHablemos lang={lang} />}
    <script>
      // M06: entrada del contenido del caso al llegar con ClientRouter.
      import '../scripts/motion/paginas';
    </script>
  </body>
</html>
