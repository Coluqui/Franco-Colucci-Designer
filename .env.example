# Copiá este archivo a `.env` (local) y cargá los mismos valores en Vercel → Settings → Environment Variables.
# Sin RESEND_API_KEY el sitio compila igual y el formulario muestra "error de envío".

# Clave de la API de Resend (resend.com → API Keys). Secreta.
RESEND_API_KEY=

# Mail que recibe los mensajes del formulario. Sin dominio propio verificado en Resend,
# tiene que ser el mismo mail de la cuenta de Resend.
CONTACTO_DESTINO=

# Remitente. Sin dominio verificado, Resend solo permite onboarding@resend.dev.
CONTACTO_REMITENTE="Portfolio <onboarding@resend.dev>"
